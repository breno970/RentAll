@page
@model ForgotPasswordConfirmation
@{ ViewData["Title"] = "Verifique seu e-mail"; }
<div class="auth-wrap"><div class="auth-card">
    <div class="eyebrow">Recuperação de conta</div><h1>Verifique seu e-mail</h1>
    <p class="intro">Se a conta estiver cadastrada e o envio de e-mail estiver configurado, você receberá instruções para redefinir a senha.</p>
    <a asp-page="./Login" class="btn btn-primary" style="width:100%">Voltar ao login</a>
</div></div>
