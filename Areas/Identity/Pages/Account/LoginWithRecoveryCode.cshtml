@page
@model LoginWithRecoveryCodeModel
@{ ViewData["Title"] = "Código de recuperação"; }
<div class="page-width"><section class="auth-shell"><div class="auth-panel"><div class="empty-symbol"><i class="fas fa-key" aria-hidden="true"></i></div><h1>Código de recuperação</h1><p class="auth-lead">Usa um dos códigos de recuperação guardados anteriormente. Cada código só pode ser utilizado uma vez.</p><form method="post" data-submit-lock><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="field"><label asp-for="Input.RecoveryCode">Código de recuperação</label><input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" required /><span asp-validation-for="Input.RecoveryCode" class="text-danger"></span></div><button class="btn btn-brand auth-wide" type="submit">Confirmar acesso</button></form></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
