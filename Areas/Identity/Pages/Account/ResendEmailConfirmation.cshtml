@page
@model ResendEmailConfirmationModel
@{ ViewData["Title"] = "Reenviar confirmação"; }
<div class="page-width"><section class="auth-shell"><div class="auth-panel"><div class="empty-symbol"><i class="fas fa-paper-plane" aria-hidden="true"></i></div><h1>Reenviar confirmação</h1><p class="auth-lead">Indica o e-mail associado à conta para pedir uma nova mensagem de confirmação.</p><form method="post" data-submit-lock><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" type="email" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div><button class="btn btn-brand auth-wide" type="submit">Reenviar e-mail</button></form><div class="auth-row"><a asp-page="./Login">Voltar ao login</a></div></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
