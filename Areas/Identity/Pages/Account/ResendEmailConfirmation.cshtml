@page
@model ResendEmailConfirmationModel
@{ ViewData["Title"] = "Confirmar e-mail"; }
<div class="auth-wrap"><div class="auth-card">
    <div class="eyebrow">Verificação de conta</div><h1>Reenviar confirmação</h1>
    <p class="intro">Introduza o e-mail para solicitar um novo link de confirmação.</p>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" required placeholder="seu@email.com" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
        <button class="btn btn-primary" type="submit">Reenviar confirmação</button>
    </form>
    <div class="auth-links center"><a asp-page="./Login">← Voltar ao login</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
