@page
@model ResetPasswordModel
@{ ViewData["Title"] = "Redefinir palavra-passe"; }
<div class="page-width"><div class="auth-shell"><div class="auth-panel">
    <p class="eyebrow">Protege a tua conta</p>
    <h1>Nova palavra-passe</h1>
    <p class="auth-lead">Escolhe uma palavra-passe forte e diferente das que usas noutros serviços.</p>
    <form method="post" data-submit-lock>
        <input asp-for="Input.Code" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
        <div class="field"><label asp-for="Input.Password">Nova palavra-passe</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
        <div class="field"><label asp-for="Input.ConfirmPassword">Confirmar palavra-passe</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="btn btn-brand auth-wide">Guardar nova palavra-passe</button>
    </form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
