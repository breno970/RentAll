@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<div>
    <p class="eyebrow">Informações pessoais</p>
    <h2>O meu perfil</h2>
    <p class="muted">Atualiza o contacto de telefone e confirma o e-mail associado à conta.</p>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="profile-form" method="post" style="max-width:530px;margin-top:20px" data-submit-lock>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-field" style="margin-bottom:16px"><label asp-for="Username">E-mail / nome de utilizador</label><input asp-for="Username" class="form-control" disabled /><small>Para alterar o e-mail, usa a secção própria.</small></div>
        <div class="form-field"><label asp-for="Input.PhoneNumber">Número de telefone</label><input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" type="tel" /><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div>
        <div class="form-actions"><button id="update-profile-button" class="btn btn-primary" type="submit"><i class="fas fa-save"></i> Guardar perfil</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
