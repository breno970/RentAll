@page
@model IndexModel
@{
    ViewData["Title"] = "Meu perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<h2 style="font-size:1.32rem;margin:0 0 8px">Meu perfil</h2>
<p class="muted">Confira os dados de acesso e atualize o seu telefone.</p>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="text-danger field full"></div>
    <div class="field full"><label asp-for="Username">E-mail da conta</label><input asp-for="Username" class="form-control" disabled /><small>O endereço de e-mail pode ser alterado na secção E-mail.</small></div>
    <div class="field full"><label asp-for="Input.PhoneNumber">Telefone</label><input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div>
    <div class="field full"><button id="update-profile-button" type="submit" class="btn btn-primary">Guardar perfil</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
