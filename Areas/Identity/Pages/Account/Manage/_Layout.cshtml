@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Minha conta";
}
<div class="page-heading">
    <div><div class="eyebrow">Configurações</div><h1>Minha conta</h1><p>Gerencie os dados e a segurança do seu perfil.</p></div>
</div>
<div class="detail-card">
    <div class="row g-4">
        <aside class="col-lg-4">
            <h2 style="font-size:1.05rem;margin:0 0 15px">Configurações</h2>
            <partial name="_ManageNav" />
        </aside>
        <section class="col-lg-8" aria-label="Definições da conta">
            @RenderBody()
        </section>
    </div>
</div>
@section Scripts {
    @RenderSection("Scripts", required: false)
}
