@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="page-width">
    <div class="page-intro">
        <div><p class="eyebrow">Definições</p><h1>A minha conta</h1><p>Controla o teu perfil, a segurança e os dados pessoais.</p></div>
        <a class="btn btn-outline" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left"></i> Voltar ao início</a>
    </div>
    <div class="panel account-layout">
        <aside aria-label="Menu das definições">
            <h2 style="font-size:1rem">Conta e segurança</h2>
            <partial name="_ManageNav" />
        </aside>
        <section aria-label="Definições da conta">
            @RenderBody()
        </section>
    </div>
</div>
@section Scripts { @RenderSection("Scripts", required: false) }
