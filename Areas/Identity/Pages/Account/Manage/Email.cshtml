@page
@model EmailModel
@{
    ViewData["Title"] = "E-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<h2 style="font-size:1.32rem;margin:0 0 8px">E-mail da conta</h2>
<p class="muted">Atualize o endereço usado para entrar e receber mensagens da RentAll.</p>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="field"><label asp-for="Email">E-mail atual</label><input asp-for="Email" class="form-control" disabled /></div>
    <div style="margin:10px 0 22px">
        @if (Model.IsEmailConfirmed)
        { <span class="badge-pill">✓ E-mail confirmado</span> }
        else
        { <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-secondary btn-sm">Enviar confirmação</button> }
    </div>
    <div class="field"><label asp-for="Input.NewEmail">Novo e-mail</label><input asp-for="Input.NewEmail" class="form-control" type="email" autocomplete="email" placeholder="novo@email.com" /><span asp-validation-for="Input.NewEmail" class="text-danger"></span></div>
    <div class="form-actions"><button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Atualizar e-mail</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
