@page
@model EmailModel
@{
    ViewData["Title"] = "E-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<div>
    <p class="eyebrow">Contactos</p>
    <h2>E-mail da conta</h2>
    <p class="muted">Gere o endereço utilizado para entrar e receber notificações.</p>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="email-form" method="post" style="max-width:530px;margin-top:20px" data-submit-lock>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="form-field" style="margin-bottom:16px">
            <label asp-for="Email">E-mail atual</label>
            <input asp-for="Email" class="form-control" disabled />
            @if (Model.IsEmailConfirmed)
            { <span class="pill" style="align-self:flex-start"><i class="fas fa-check"></i> Confirmado</span> }
            else
            { <button id="email-verification" class="btn btn-outline btn-sm" type="submit" asp-page-handler="SendVerificationEmail" style="align-self:flex-start">Reenviar confirmação</button> }
        </div>
        <div class="form-field">
            <label asp-for="Input.NewEmail">Novo e-mail</label>
            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" type="email" placeholder="novo@email.com" />
            <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
        </div>
        <div class="form-actions"><button id="change-email-button" class="btn btn-primary" type="submit" asp-page-handler="ChangeEmail"><i class="fas fa-save"></i> Atualizar e-mail</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
