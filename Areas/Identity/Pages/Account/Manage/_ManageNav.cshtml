@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<nav class="nav nav-pills flex-column" aria-label="Definições da conta">
    <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index"><i class="far fa-user" aria-hidden="true"></i> Perfil</a>
    <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email"><i class="far fa-envelope" aria-hidden="true"></i> E-mail</a>
    <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword"><i class="fas fa-lock" aria-hidden="true"></i> Palavra-passe</a>
    @if (hasExternalLogins)
    { <a class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" id="external-login" asp-page="./ExternalLogins"><i class="fas fa-link" aria-hidden="true"></i> Logins externos</a> }
    <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication"><i class="fas fa-shield-alt" aria-hidden="true"></i> Verificação em dois passos</a>
    <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData"><i class="fas fa-user-shield" aria-hidden="true"></i> Dados pessoais</a>
</nav>
