@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}
<div>
    <p class="eyebrow">Segurança</p>
    <h2>Alterar palavra-passe</h2>
    <p class="muted">Usa uma palavra-passe forte que não utilizas noutros serviços.</p>
    <partial name="_StatusMessage" for="StatusMessage" />
    <form id="change-password-form" method="post" style="max-width:530px;margin-top:20px" data-submit-lock>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-field" style="margin-bottom:16px"><label asp-for="Input.OldPassword">Palavra-passe atual</label><input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" required /><span asp-validation-for="Input.OldPassword" class="text-danger"></span></div>
        <div class="form-field" style="margin-bottom:16px"><label asp-for="Input.NewPassword">Nova palavra-passe</label><input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.NewPassword" class="text-danger"></span></div>
        <div class="form-field"><label asp-for="Input.ConfirmPassword">Confirmar nova palavra-passe</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fas fa-lock"></i> Atualizar palavra-passe</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
