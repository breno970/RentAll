@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}
<h2 style="font-size:1.32rem;margin:0 0 8px">Alterar senha</h2>
<p class="muted">Escolha uma senha forte e exclusiva para proteger a sua conta.</p>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="field"><label asp-for="Input.OldPassword">Senha atual</label><input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" required /><span asp-validation-for="Input.OldPassword" class="text-danger"></span></div>
    <div class="field" style="margin-top:17px"><label asp-for="Input.NewPassword">Nova senha</label><input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.NewPassword" class="text-danger"></span></div>
    <div class="field" style="margin-top:17px"><label asp-for="Input.ConfirmPassword">Confirmar nova senha</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Atualizar senha</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
