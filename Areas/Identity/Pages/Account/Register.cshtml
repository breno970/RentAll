@page
@model RegisterModel
@{ ViewData["Title"] = "Criar conta"; }
<div class="auth-wrap">
    <div class="auth-card">
        <div class="eyebrow">Faça parte do RentAll</div>
        <h1>Crie sua conta</h1>
        <p class="intro">Cadastre-se para anunciar itens e descobrir oportunidades de aluguel.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="field"><label asp-for="Input.FirstName">Nome *</label><input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" required /><span asp-validation-for="Input.FirstName" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.LastName">Sobrenome *</label><input asp-for="Input.LastName" class="form-control" autocomplete="family-name" required /><span asp-validation-for="Input.LastName" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.Email">E-mail *</label><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="seu@email.com" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.Password">Senha *</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" required /><small>Pelo menos 8 caracteres, com maiúsculas, minúsculas, número e símbolo.</small><span asp-validation-for="Input.Password" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.ConfirmPassword">Confirmar senha *</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
            <label class="form-check" style="margin:14px 0 5px;display:flex;align-items:start;gap:10px"><input type="checkbox" name="acceptTerms" required class="form-check-input" style="margin-top:5px" /><span>Li e aceito os <a asp-area="" asp-controller="Termos" asp-action="Index" target="_blank" rel="noopener">termos de utilização</a> da RentAll.</span></label>
            <button class="btn btn-primary" type="submit">Criar minha conta</button>
        </form>
        <div class="auth-links center"><span>Já tem uma conta?</span><a asp-page="./Login">Entrar</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
