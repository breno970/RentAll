@page
@model RegisterModel
@{ ViewData["Title"] = "Criar conta"; }
<link rel="stylesheet" href="~/css/marketplace-enhancements.css" asp-append-version="true" />
<div class="page-width">
    <section class="auth-shell ra-register-shell" style="max-width:570px">
        <div class="auth-panel ra-register-panel">
            <p class="eyebrow">Faz parte da comunidade</p>
            <h1>Cria a tua conta</h1>
            <p class="auth-lead">Encontra artigos perto de ti ou transforma objetos parados em oportunidades de aluguer.</p>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-submit-lock data-registration-form>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-grid" style="gap:13px;margin-bottom:15px">
                    <div class="form-field"><label asp-for="Input.FirstName">Nome *</label><input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" required /><span asp-validation-for="Input.FirstName" class="text-danger"></span></div>
                    <div class="form-field"><label asp-for="Input.LastName">Apelido / Sobrenome *</label><input asp-for="Input.LastName" class="form-control" autocomplete="family-name" required /><span asp-validation-for="Input.LastName" class="text-danger"></span></div>
                </div>
                <div class="field" style="margin-bottom:15px"><label asp-for="Input.Email">E-mail *</label><input asp-for="Input.Email" class="form-control" autocomplete="email" type="email" placeholder="o-teu@email.com" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
                <div class="field" style="margin-bottom:15px">
                    <label asp-for="Input.Password">Palavra-passe *</label>
                    <div class="password-field">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" required />
                        <button type="button" class="password-toggle" data-toggle-password="Input_Password" aria-label="Mostrar palavra-passe"><i class="far fa-eye"></i></button>
                    </div>
                    <small class="muted">Mínimo de 8 caracteres, incluindo letras maiúsculas, minúsculas, números e símbolos.</small>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="field" style="margin-bottom:17px">
                    <label asp-for="Input.ConfirmPassword">Confirmar palavra-passe *</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="ra-consent-wrap">
                    <label class="ra-consent-check" for="AcceptTerms">
                        <input id="AcceptTerms" name="AcceptTerms" type="checkbox" value="true" required
                               checked="@Model.AcceptTerms" aria-describedby="terms-description" />
                        <span class="ra-consent-box" aria-hidden="true"><i class="fas fa-check"></i></span>
                        <span id="terms-description">Li e aceito os <a asp-area="" asp-controller="Termos" asp-action="Index" target="_blank" rel="noopener noreferrer">termos de utilização</a> e consultei a <a asp-area="" asp-controller="Privacidade" asp-action="Index" target="_blank" rel="noopener noreferrer">informação de privacidade</a>.</span>
                    </label>
                    <span asp-validation-for="AcceptTerms" class="text-danger" role="alert"></span>
                </div>
                <button class="btn btn-brand auth-wide" type="submit"><i class="fas fa-user-plus" aria-hidden="true"></i> Criar conta</button>
            </form>
            <div class="auth-divider"></div>
            <p style="text-align:center;margin:0">Já tens uma conta? <a asp-page="./Login">Entrar</a></p>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
