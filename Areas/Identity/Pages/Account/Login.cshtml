@page
@model LoginModel
@{ ViewData["Title"] = "Entrar"; }
<div class="page-width">
    <section class="auth-shell">
        <div class="auth-panel">
            <p class="eyebrow">Bem-vindo de volta</p>
            <h1>Entrar na RentAll</h1>
            <p class="auth-lead">Acede aos teus artigos, anúncios e favoritos.</p>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-submit-lock>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="field">
                    <label asp-for="Input.Email">E-mail</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" type="email" placeholder="o-teu@email.com" required />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Password">Palavra-passe</label>
                    <div class="password-field">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" required />
                        <button class="password-toggle" type="button" data-toggle-password="Input_Password" aria-label="Mostrar palavra-passe"><i class="far fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="auth-row">
                    <label class="check-line"><input asp-for="Input.RememberMe" type="checkbox" /> Manter a sessão iniciada</label>
                    <a asp-page="./ForgotPassword">Esqueci a palavra-passe</a>
                </div>
                <button class="btn btn-brand auth-wide" type="submit"><i class="fas fa-sign-in-alt"></i> Entrar</button>
            </form>
            <div class="auth-divider"></div>
            <p class="muted" style="text-align:center">Ainda não tens conta?</p>
            <a class="btn btn-outline auth-wide" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Criar conta gratuitamente</a>
            <p style="font-size:.8rem;text-align:center;margin:17px 0 0"><a asp-page="./ResendEmailConfirmation">Reenviar confirmação de e-mail</a></p>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
