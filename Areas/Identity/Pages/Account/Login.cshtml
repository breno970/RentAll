@page
@model LoginModel
@{ ViewData["Title"] = "Entrar"; }
<div class="auth-wrap">
    <div class="auth-card">
        <div class="eyebrow">Bem-vindo de volta</div>
        <h1>Entre na sua conta</h1>
        <p class="intro">Acesse seus anúncios, itens e informações pessoais.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="seu@email.com" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.Password">Senha</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Sua senha" required /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
            <div class="auth-links">
                <label class="form-check"><input asp-for="Input.RememberMe" class="form-check-input" /> Manter sessão iniciada</label>
                <a asp-page="./ForgotPassword">Esqueci minha senha</a>
            </div>
            <button type="submit" class="btn btn-primary">Entrar</button>
        </form>
        <div class="auth-divider"></div>
        <p class="muted" style="text-align:center">Ainda não tem uma conta?</p>
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline" style="width:100%">Criar conta gratuita</a>
        <div class="auth-links center"><a asp-page="./ResendEmailConfirmation">Reenviar confirmação por e-mail</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
