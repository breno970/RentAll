@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "Recuperar senha"; }
<div class="auth-wrap"><div class="auth-card">
    <div class="eyebrow">Segurança da conta</div><h1>Recuperar senha</h1>
    <p class="intro">Informe o e-mail associado à sua conta para receber as instruções de redefinição.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="seu@email.com" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
        <button class="btn btn-primary" type="submit">Solicitar redefinição</button>
    </form>
    <div class="auth-links center"><a asp-page="./Login">← Voltar ao login</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
