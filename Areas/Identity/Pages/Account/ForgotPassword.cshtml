@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "Recuperar palavra-passe"; }
<div class="page-width"><div class="auth-shell"><div class="auth-panel">
    <p class="eyebrow">Recuperação de conta</p>
    <h1>Esqueceste a palavra-passe?</h1>
    <p class="auth-lead">Introduz o teu e-mail para receberes as instruções de recuperação.</p>
    <form method="post" data-submit-lock>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" class="form-control" autocomplete="email" type="email" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
        <button type="submit" class="btn btn-brand auth-wide">Pedir link de recuperação</button>
    </form>
    <div class="auth-row"><a asp-page="./Login"><i class="fas fa-arrow-left"></i> Voltar ao login</a></div>
    <p class="muted" style="font-size:.8rem">O envio de mensagens depende da configuração do serviço de e-mail da plataforma.</p>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
