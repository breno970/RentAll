@page
@model RegisterConfirmationModel
@{ ViewData["Title"] = "Confirmar e-mail"; }
<div class="page-width"><section class="auth-shell"><div class="auth-panel"><div class="empty-symbol"><i class="fas fa-envelope" aria-hidden="true"></i></div><h1>Confirma o teu e-mail</h1><p class="auth-lead">Se a confirmação de e-mail estiver ativa, verifica a caixa de entrada de <strong>@Model.Email</strong> para concluir o registo.</p><div class="helper-banner"><i class="fas fa-info-circle"></i><span>Se não receberes a mensagem, verifica a pasta de spam ou solicita um novo envio.</span></div><div class="form-actions"><a class="btn btn-primary" asp-page="./Login">Entrar</a><a class="btn btn-outline" asp-page="./ResendEmailConfirmation">Reenviar confirmação</a></div></div></section></div>
