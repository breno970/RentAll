@model aluguel.Models.Anuncio
@{
    ViewData["Title"] = Model.item?.nmitem ?? Model.modelo;
    var photos = new[] { Model.item?.imagem1, Model.item?.imagem2, Model.item?.imagem3, Model.item?.imagem4, Model.item?.imagem5 }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    var place = string.Join(", ", new[] { Model.Cidade, Model.Estado, aluguel.Services.LocationCatalog.CountryName(Model.Pais) });
    var mapsUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(place);
    var isSaved = ViewData["IsFavorite"] is bool value && value;
}
<div class="page-width">
    <div class="page-intro">
        <div><p class="eyebrow"><a asp-controller="Home" asp-action="Index" asp-route-Pais="@Model.Pais">Explorar</a> / Detalhes do anúncio</p><h1>@(Model.item?.nmitem ?? Model.modelo)</h1><p><i class="fas fa-map-marker-alt"></i> @place</p></div>
        <a class="btn btn-outline" asp-controller="Home" asp-action="Index" asp-route-Pais="@Model.Pais"><i class="fas fa-arrow-left"></i> Voltar à pesquisa</a>
    </div>
    <div class="detail-layout">
        <div>
            <div class="panel">
                @if (photos.Length > 0)
                {
                    <img class="detail-main-image" src="@Url.Content("~/imagens/" + photos[0])" alt="Fotografia de @(Model.item?.nmitem ?? Model.modelo)" data-gallery-main />
                    @if (photos.Length > 1)
                    {
                        <div class="gallery-thumbs" aria-label="Galeria de fotografias">
                            @for (var i = 0; i < photos.Length; i++)
                            {
                                var url = Url.Content("~/imagens/" + photos[i]);
                                <button class="gallery-thumb" type="button" data-gallery-image="@url" data-gallery-alt="Fotografia @(i + 1) do artigo" aria-label="Ver fotografia @(i + 1)" aria-pressed="@(i == 0 ? "true" : "false")">
                                    <img src="@url" alt="" loading="lazy" />
                                </button>
                            }
                        </div>
                    }
                }
                else { <div class="detail-main-image image-empty"><i class="far fa-image"></i></div> }
            </div>
            <div class="panel" style="margin-top:18px">
                <h2>Sobre este artigo</h2>
                <p class="detail-description">@(Model.item?.dsitem ?? "Não existe uma descrição adicional.")</p>
            </div>
        </div>
        <aside class="panel">
            <span class="pill"><i class="fas fa-leaf"></i> Aluguer de objeto em desuso</span>
            <h1 class="detail-name" style="margin:18px 0 6px">@(Model.item?.nmitem ?? Model.modelo)</h1>
            <p class="muted">@Model.modelo</p>
            <div class="detail-price">@aluguel.Services.RentalLocalization.FormatPrice(Model.vlitem, Model.Pais) <small>/ dia</small></div>
            <div class="detail-facts">
                <div><small>Período</small><strong>Até @Model.diasAluguel dia(s)</strong></div>
                <div><small>Categoria</small><strong>@(Model.categoria?.nmcategoria ?? "Outros")</strong></div>
                <div><small>Tipo</small><strong>@(Model.tipo?.nmtipo ?? "Outros")</strong></div>
                <div><small>Localização</small><strong>@Model.Cidade, @Model.Estado</strong></div>
            </div>
            <div class="contact-box">
                <h2 style="font-size:1rem">Falar com o anunciante</h2>
                <p class="muted" style="font-size:.88rem">Publicado por <strong>@Model.NomeFantasia</strong></p>
                <p style="margin:0"><i class="fas fa-phone-alt" aria-hidden="true"></i> <strong>@Model.contato</strong></p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Favoritos" asp-action="Toggle" method="post" style="margin:15px 0">
                    <input type="hidden" name="anuncioId" value="@Model.id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="btn btn-outline" style="width:100%">
                        <i class="@(isSaved ? "fas" : "far") fa-heart" aria-hidden="true"></i>
                        @(isSaved ? "Remover dos favoritos" : "Guardar nos favoritos")
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-outline" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path"><i class="far fa-heart"></i> Entrar para guardar</a>
            }
            <div class="helper-banner"><i class="fas fa-shield-alt"></i><span>Por privacidade, a rua e a porta não são divulgadas. Combina a entrega diretamente com o anunciante.</span></div>
            <a class="btn btn-outline" href="@mapsUrl" target="_blank" rel="noopener noreferrer"><i class="fas fa-map-marker-alt"></i> Ver zona no Google Maps</a>
            <div class="ra-map-preview" data-ra-map data-place="@place" hidden style="margin-top:12px"></div>
        </aside>
    </div>
</div>
