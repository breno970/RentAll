@model aluguel.Models.Anuncio
@{
    ViewData["Title"] = Model.item?.nmitem ?? Model.modelo;
    var photos = new[] { Model.item?.imagem1, Model.item?.imagem2, Model.item?.imagem3, Model.item?.imagem4, Model.item?.imagem5 }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    var place = string.Join(", ", new[] { Model.Cidade, Model.Estado, aluguel.Services.LocationCatalog.CountryName(Model.Pais) });
    var mapsUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(place);
    var isSaved = ViewData["IsFavorite"] is bool value && value;
}
<link rel="stylesheet" href="~/css/photo-carousel.css" asp-append-version="true" />
<div class="page-width">
    <div class="page-intro">
        <div><p class="eyebrow"><a asp-controller="Home" asp-action="Index" asp-route-Pais="@Model.Pais">Explorar</a> / Detalhes do anúncio</p><h1>@(Model.item?.nmitem ?? Model.modelo)</h1><p><i class="fas fa-map-marker-alt"></i> @place</p></div>
        <a class="btn btn-outline" asp-controller="Home" asp-action="Index" asp-route-Pais="@Model.Pais"><i class="fas fa-arrow-left"></i> Voltar à pesquisa</a>
    </div>
    <div class="detail-layout">
        <div>
            <div class="panel">
                @if (photos.Length > 0)
                {
                    <div class="ra-photo-view" data-photo-carousel-view>
                        @foreach (var photo in photos)
                        {
                            <span data-view-photo="@Url.Content("~/imagens/" + photo)" hidden></span>
                        }
                        <div class="ra-photo-stage">
                            <button type="button" data-view-prev aria-label="Fotografia anterior"><i class="fas fa-chevron-left"></i></button>
                            <div class="ra-photo-frame">
                                <img class="detail-main-image" data-view-main alt="Fotografia de @(Model.item?.nmitem ?? Model.modelo)" />
                                <p data-view-counter aria-live="polite"></p>
                            </div>
                            <button type="button" data-view-next aria-label="Próxima fotografia"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>
                }
                else { <div class="detail-main-image image-empty"><i class="far fa-image"></i></div> }
            </div>
            <div class="panel" style="margin-top:18px">
                <h2>Sobre este artigo</h2>
                <p class="detail-description">@(Model.item?.dsitem ?? "Não existe uma descrição adicional.")</p>
            </div>
        </div>
        <aside class="panel">
            <span class="pill"><i class="fas fa-leaf"></i> Aluguer de objeto em desuso</span>
            <h1 class="detail-name" style="margin:18px 0 6px">@(Model.item?.nmitem ?? Model.modelo)</h1>
            @if (!string.IsNullOrWhiteSpace(Model.modelo)) { <p class="muted">@Model.modelo</p> }
            <div class="detail-price">@aluguel.Services.RentalLocalization.FormatPrice(Model.vlitem, Model.Pais) @if (Model.vlitem > 0) { <small>/ dia</small> }</div>
            <div class="detail-facts">
                <div><small>Período</small><strong>@(Model.diasAluguel > 0 ? $"Até {Model.diasAluguel} dia(s)" : "A combinar")</strong></div>
                <div><small>Categoria</small><strong>@(Model.categoria?.nmcategoria ?? "Outros")</strong></div>
                <div><small>Tipo</small><strong>@(Model.tipo?.nmtipo ?? "Outros")</strong></div>
                <div><small>Localização</small><strong>@Model.Cidade, @Model.Estado</strong></div>
            </div>
            <div class="contact-box">
                <h2 style="font-size:1rem">Falar com o anunciante</h2>
                <p class="muted" style="font-size:.88rem">Publicado por <strong>@(string.IsNullOrWhiteSpace(Model.NomeFantasia) ? "Anunciante RentAll" : Model.NomeFantasia)</strong></p>
                <a asp-controller="Perfis" asp-action="Details" asp-route-id="@Model.iduser" class="btn btn-outline"><i class="far fa-user"></i> Ver perfil e outros anúncios</a>
                @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.iduser)
                {
                    <a asp-controller="Mensagens" asp-action="Conversa" asp-route-anuncioId="@Model.id" class="btn btn-primary" style="margin-top:12px"><i class="far fa-comments"></i> Enviar mensagem na RentAll</a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Mensagens" asp-action="Index" class="btn btn-outline" style="margin-top:12px">Ver mensagens recebidas</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details","Anuncios",new { id = Model.id })" class="btn btn-primary" style="margin-top:12px">Entrar para enviar mensagem</a>
                }
                <p class="muted" style="margin-top:12px">O contacto pessoal e a morada não são divulgados publicamente.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Favoritos" asp-action="Toggle" method="post" style="margin:15px 0">
                    <input type="hidden" name="anuncioId" value="@Model.id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="btn btn-outline" style="width:100%">
                        <i class="@(isSaved ? "fas" : "far") fa-heart" aria-hidden="true"></i>
                        @(isSaved ? "Remover dos favoritos" : "Guardar nos favoritos")
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-outline" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path"><i class="far fa-heart"></i> Entrar para guardar</a>
            }
            <div class="helper-banner"><i class="fas fa-shield-alt"></i><span>Por privacidade, a rua e a porta não são divulgadas. Nunca partilhes palavras-passe, códigos de acesso ou documentos pessoais.</span></div>
            <a class="btn btn-outline" href="@mapsUrl" target="_blank" rel="noopener noreferrer"><i class="fas fa-map-marker-alt"></i> Ver zona no Google Maps</a>
            <button class="btn btn-outline" type="button" data-load-approx-map style="margin-top:12px">Mostrar mapa aproximado</button>
            <p data-inline-map-status role="status"></p>
            <div class="ra-map-preview" data-ra-map data-place="@place" hidden style="margin-top:12px"></div>
        </aside>
    </div>
</div>

@section Scripts { <script src="~/js/photo-carousel.js" asp-append-version="true"></script> }
