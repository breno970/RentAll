@model aluguel.Models.Anuncio
@using aluguel.Services
@{
    ViewData["Title"] = "Editar Anúncio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card-it ra-ad-editor">
    <h1>Editar Anúncio</h1>
    <p class="ra-field-hint">Atualize o preço, a disponibilidade e a região do anúncio.</p>
    <form asp-action="Edit" method="post" class="ra-ad-form">
        <input asp-for="id" type="hidden" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <h2><i class="fas fa-box-open" aria-hidden="true"></i> Detalhes do anúncio</h2>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="modelo">Modelo *</label>
                <input asp-for="modelo" class="form-control" required maxlength="150" />
                <span asp-validation-for="modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="vlitem">Valor por dia (R$) *</label>
                <input asp-for="vlitem" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" required />
                <span asp-validation-for="vlitem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="diasAluguel">Dias disponíveis *</label>
                <input asp-for="diasAluguel" type="number" min="1" max="365" class="form-control" required />
                <span asp-validation-for="diasAluguel" class="text-danger"></span>
            </div>
        </div>

        <h2><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Região do item</h2>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="Estado">Estado *</label>
                <select asp-for="Estado" id="txtEstado" class="form-control" data-region-uf required>
                    <option value="">Selecione o estado</option>
                    @foreach (var uf in LocationCatalog.States)
                    {
                        <option value="@uf.Code">@uf.Name (@uf.Code)</option>
                    }
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cidade">Cidade *</label>
                <input asp-for="Cidade" id="txtCidade" class="form-control" data-region-city list="ra-ad-cities" required />
                <datalist id="ra-ad-cities"></datalist>
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bairro">Bairro *</label>
                <input asp-for="Bairro" id="txtBairro" class="form-control" required />
                <span asp-validation-for="Bairro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CEP">CEP *</label>
                <input asp-for="CEP" id="txtCep" class="form-control" inputmode="numeric" maxlength="9" required />
                <span asp-validation-for="CEP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rua">Rua *</label>
                <input asp-for="Rua" id="txtRua" class="form-control" required />
            </div>
            <div class="form-group">
                <label asp-for="Numero">Número (opcional)</label>
                <input asp-for="Numero" id="txtNumero" class="form-control" inputmode="numeric" />
            </div>
            <div class="form-group ra-full">
                <label asp-for="Complemento">Complemento</label>
                <input asp-for="Complemento" class="form-control" />
            </div>
        </div>
        <div class="ra-map-actions">
            <a href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark" data-region-map-link><i class="fas fa-map-marked-alt" aria-hidden="true"></i> Ver região no Google Maps</a>
            <div class="ra-map-preview" data-ra-map hidden aria-label="Mapa aproximado da região"></div>
        </div>

        <h2><i class="fas fa-phone-alt" aria-hidden="true"></i> Contato</h2>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="NomeFantasia">Nome público *</label>
                <input asp-for="NomeFantasia" class="form-control" required />
            </div>
            <div class="form-group">
                <label asp-for="contato">Contato *</label>
                <input asp-for="contato" class="form-control" required />
            </div>
        </div>
        <div class="btn-container">
            <button type="submit" class="btn btn-primary"><i class="fas fa-check" aria-hidden="true"></i> Salvar alterações</button>
            <a asp-action="Index" class="btn btn-outline-dark">Voltar para lista</a>
        </div>
    </form>
</div>
