@model aluguel.Models.Anuncio
@using aluguel.Services
@{ ViewData["Title"] = "Editar anúncio"; }
<div class="page-width"><div class="form-shell">
    <div class="page-intro"><div><p class="eyebrow">Meus anúncios / Edição</p><h1>Editar anúncio</h1><p>Atualiza o preço, a localização e os teus contactos.</p></div><a class="btn btn-outline" asp-action="Index"><i class="fas fa-arrow-left"></i> Voltar</a></div>
    <form class="form-panel" asp-action="Edit" method="post" data-submit-lock>
        <input asp-for="id" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <h2>Detalhes do aluguer</h2>
        <div class="form-grid">
            <div class="form-field full"><label asp-for="modelo">Modelo / referência *</label><input asp-for="modelo" class="form-control" required /><span asp-validation-for="modelo" class="text-danger"></span></div>
            <div class="form-field"><label asp-for="vlitem" data-rental-currency>Valor por dia (@(Model.Pais == "PT" ? "€" : "R$")) *</label><input asp-for="vlitem" class="form-control" type="number" min="0.01" step="0.01" required /><span asp-validation-for="vlitem" class="text-danger"></span></div>
            <div class="form-field"><label asp-for="diasAluguel">Dias disponíveis *</label><input asp-for="diasAluguel" class="form-control" type="number" min="1" max="365" required /><span asp-validation-for="diasAluguel" class="text-danger"></span></div>
        </div>
        <h2>Localização</h2>
        <div class="form-grid">
            <div class="form-field"><label asp-for="Pais">País *</label><select asp-for="Pais" class="form-select" data-region-country required><option value="BR">Brasil</option><option value="PT">Portugal</option></select></div>
            <div class="form-field"><label asp-for="Estado" data-region-label>@LocationCatalog.RegionLabel(Model.Pais) *</label><select asp-for="Estado" class="form-select" data-region-uf required><option value="">Escolhe a região</option>@foreach (var region in LocationCatalog.RegionsFor(Model.Pais)) { <option value="@region.Code">@region.Name</option> }</select><span asp-validation-for="Estado" class="text-danger"></span></div>
            <div class="form-field"><label asp-for="Cidade">Cidade / município *</label><input asp-for="Cidade" id="txtCidade" data-region-city list="ad-cities" class="form-control" required /><datalist id="ad-cities"></datalist></div>
            <div class="form-field"><label asp-for="Bairro">Bairro / freguesia *</label><input asp-for="Bairro" id="txtBairro" class="form-control" required /></div>
            <div class="form-field"><label asp-for="CEP" data-postal-label>@LocationCatalog.PostalLabel(Model.Pais) *</label><input asp-for="CEP" id="txtCep" class="form-control" maxlength="9" required inputmode="numeric" /></div>
            <div class="form-field"><label asp-for="Rua">Rua *</label><input asp-for="Rua" id="txtRua" class="form-control" required /></div>
            <div class="form-field"><label asp-for="Numero">Número</label><input asp-for="Numero" id="txtNumero" class="form-control" /></div>
            <div class="form-field"><label asp-for="Complemento">Complemento</label><input asp-for="Complemento" class="form-control" /></div>
        </div>
        <div class="inline-map"><a data-region-map-link class="btn btn-outline" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps"><i class="fas fa-map-marked-alt"></i> Ver região no Maps</a><div class="ra-map-preview" data-ra-map hidden></div></div>
        <h2>Contacto</h2>
        <div class="form-grid">
            <div class="form-field"><label asp-for="NomeFantasia">Nome público *</label><input asp-for="NomeFantasia" class="form-control" required /></div>
            <div class="form-field"><label asp-for="contato">Contacto *</label><input asp-for="contato" class="form-control" required /></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fas fa-save"></i> Guardar alterações</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
