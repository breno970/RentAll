@model aluguel.Models.Anuncio
@{ ViewData["Title"] = "Editar anúncio"; }
<div class="form-shell">
    <div class="page-heading"><div><div class="eyebrow">Meus anúncios / Edição</div><h1>Editar anúncio</h1><p>Atualize preço, disponibilidade e informações de contato.</p></div><a asp-action="Index" class="btn btn-outline">← Voltar</a></div>
    <form asp-action="Edit" method="post" class="form-card">
        <input asp-for="id" type="hidden" />
        <input asp-for="iduser" type="hidden" />
        <input asp-for="itemid" type="hidden" />
        <input asp-for="categoriaid" type="hidden" />
        <input asp-for="tipoid" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h2>Detalhes do aluguel</h2>
        <div class="form-grid">
            <div class="field"><label asp-for="vlitem">Valor por dia (R$) *</label><input asp-for="vlitem" type="number" min="0.01" step="0.01" class="form-control" required /><span asp-validation-for="vlitem" class="text-danger"></span></div>
            <div class="field"><label asp-for="diasAluguel">Dias disponíveis *</label><input asp-for="diasAluguel" type="number" min="1" class="form-control" required /><span asp-validation-for="diasAluguel" class="text-danger"></span></div>
            <div class="field full"><label asp-for="modelo">Modelo / referência *</label><input asp-for="modelo" class="form-control" required /><span asp-validation-for="modelo" class="text-danger"></span></div>
        </div>
        <h2>Localização</h2>
        <div class="form-grid">
            <div class="field"><label asp-for="CEP">CEP *</label><input asp-for="CEP" id="txtCep" class="form-control" maxlength="9" required /></div>
            <div class="field"><label asp-for="Estado">Estado (UF) *</label><input asp-for="Estado" id="txtEstado" maxlength="2" class="form-control" required /></div>
            <div class="field"><label asp-for="Cidade">Cidade *</label><input asp-for="Cidade" id="txtCidade" class="form-control" required /></div>
            <div class="field"><label asp-for="Bairro">Bairro *</label><input asp-for="Bairro" id="txtBairro" class="form-control" required /></div>
            <div class="field full"><label asp-for="Rua">Rua *</label><input asp-for="Rua" id="txtRua" class="form-control" required /></div>
            <div class="field"><label asp-for="Numero">Número</label><input asp-for="Numero" id="txtNumero" class="form-control" /></div>
            <div class="field"><label asp-for="Complemento">Complemento</label><input asp-for="Complemento" class="form-control" /></div>
        </div>
        <h2>Contato</h2>
        <div class="form-grid">
            <div class="field"><label asp-for="NomeFantasia">Nome para contato *</label><input asp-for="NomeFantasia" class="form-control" required /></div>
            <div class="field"><label asp-for="contato">Contato *</label><input asp-for="contato" class="form-control" required /></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Guardar alterações</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
    </form>
</div>
