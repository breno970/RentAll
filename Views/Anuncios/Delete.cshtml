@model aluguel.Models.Anuncio
@{ ViewData["Title"] = "Excluir anúncio"; }
<div class="form-shell">
    <div class="page-heading"><div><div class="eyebrow">Meus anúncios / Excluir</div><h1>Excluir anúncio</h1><p>Esta ação não pode ser desfeita.</p></div></div>
    <div class="form-card">
        <h2>Deseja excluir "@(Model.item?.nmitem ?? Model.modelo)"?</h2>
        <p class="muted">O anúncio deixará de aparecer na busca. O item cadastrado continuará na sua lista.</p>
        <form asp-action="Delete" method="post">
            <input asp-for="id" type="hidden" />
            <div class="form-actions"><button type="submit" class="btn btn-danger">Sim, excluir anúncio</button><a asp-action="Index" class="btn btn-outline">Cancelar</a></div>
        </form>
    </div>
</div>
