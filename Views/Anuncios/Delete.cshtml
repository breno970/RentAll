@model aluguel.Models.Anuncio
@{ ViewData["Title"] = "Excluir anúncio"; }
<div class="page-width"><div class="form-shell">
    <div class="page-intro"><div><p class="eyebrow">Meus anúncios / Exclusão</p><h1>Excluir anúncio</h1><p>Esta ação vai retirar o anúncio da pesquisa pública.</p></div></div>
    <div class="panel danger-panel">
        <span class="danger-icon"><i class="fas fa-exclamation-triangle"></i></span>
        <h2>Excluir «@(Model.item?.nmitem ?? Model.modelo)»?</h2>
        <p class="muted">O artigo original continuará guardado em «Meus itens». Podes criar outro anúncio mais tarde.</p>
        <form asp-action="Delete" method="post" data-submit-lock>
            <input asp-for="id" type="hidden" />
            <div class="form-actions"><button type="submit" class="btn btn-danger"><i class="far fa-trash-alt"></i> Sim, excluir anúncio</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
        </form>
    </div>
</div></div>
