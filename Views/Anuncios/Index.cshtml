@model IEnumerable<aluguel.Models.Anuncio>
@{ ViewData["Title"] = "Meus anúncios"; }
<div class="page-width">
    <div class="page-intro">
        <div><p class="eyebrow">A minha área</p><h1>Meus anúncios</h1><p>Acompanha o que colocaste disponível para alugar.</p></div>
        <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus"></i> Criar anúncio</a>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-symbol"><i class="far fa-list-alt"></i></div>
            <h2>Ainda não publicaste anúncios</h2>
            <p>Começa por cadastrar um item com fotografias; depois escolhe o preço, a disponibilidade e a região.</p>
            <a class="btn btn-primary" asp-controller="Items" asp-action="Create">Cadastrar um item</a>
            <a class="btn btn-outline" asp-action="Create">Já tenho um item</a>
        </div>
    }
    else
    {
        <div class="dashboard-grid">
            @foreach (var ad in Model)
            {
                <article class="manage-card">
                    @if (!string.IsNullOrWhiteSpace(ad.item?.imagem1))
                    { <img class="manage-img" src="@Url.Content("~/imagens/" + ad.item.imagem1)" alt="@(ad.item?.nmitem ?? ad.modelo)" loading="lazy" /> }
                    else { <div class="manage-img"><i class="far fa-image"></i></div> }
                    <div class="manage-body">
                        <span class="pill"><i class="fas fa-circle" style="font-size:.46rem" aria-hidden="true"></i> @(ad.Pais == "PT" ? "Anúncio · Portugal" : "Histórico · indisponível no mercado atual")</span>
                        <h2>@(ad.item?.nmitem ?? ad.modelo)</h2>
                        <p>@aluguel.Services.RentalLocalization.FormatPrice(ad.vlitem, ad.Pais) por dia · @ad.Cidade, @ad.Estado</p>
                        <div class="manage-actions">
                            <a asp-action="Details" asp-route-id="@ad.id"><i class="far fa-eye"></i> Ver</a>
                            @if (ad.Pais == "PT") { <a asp-action="Edit" asp-route-id="@ad.id"><i class="fas fa-pen"></i> Editar</a> }
                            <a class="danger-link" asp-action="Delete" asp-route-id="@ad.id"><i class="far fa-trash-alt"></i> Excluir</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
