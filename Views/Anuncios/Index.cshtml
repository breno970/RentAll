@model IEnumerable<aluguel.Models.Anuncio>
@{
    ViewData["Title"] = "Meus Anúncios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="ra-list-heading">Meus Anúncios<span>Gerencie seus anúncios</span></h1>
<div class="create-container">
    <a asp-action="Create" class="create">Criar novo</a>
</div>
@if (!Model.Any())
{
    <div class="ra-empty-state">
        <h2>Nenhum anúncio publicado</h2>
        <p>Crie um anúncio a partir de um item já cadastrado.</p>
        <a asp-action="Create" class="create">Criar anúncio</a>
    </div>
}
else
{
    <table aria-label="Meus anúncios publicados">
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="item-content">
                        <img src="~/imagens/@item.item.imagem1" class="item-image" alt="@item.item.nmitem" loading="lazy" decoding="async" />
                        <div class="item-details">
                            <div class="item-name">@item.item.nmitem</div>
                            <div class="item-name">@item.Cidade</div>
                            <div class="item-name">@item.contato</div>
                            <div class="item-actions">
                                <a href="@Url.Action("Edit", "Anuncios", new { id = item.id })" class="edit">Editar</a>
                                <a href="@Url.Action("Details", "Anuncios", new { id = item.id })" class="details">Detalhes</a>
                                <a href="@Url.Action("Delete", "Anuncios", new { id = item.id })" class="delete">Excluir</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
