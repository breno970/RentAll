@model aluguel.Models.Anuncio
@using aluguel.Services
@{
    ViewData["Title"] = "Criar Anúncio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card-it ra-ad-editor">
    <h1>Criar Anúncio</h1>
    <p class="ra-field-hint">Transforme um objeto em desuso numa oportunidade de aluguel. Informe os detalhes e escolha onde ele está disponível.</p>
    <form asp-action="Create" method="post" class="ra-ad-form">
        <div asp-validation-summary="All" class="text-danger"></div>
        <h2><i class="fas fa-box-open" aria-hidden="true"></i> Sobre o item</h2>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="itemid">Escolha o item já cadastrado *</label>
                <select asp-for="itemid" asp-items="ViewBag.itemid" class="form-control" required>
                    <option value="">Selecione um item</option>
                </select>
                <small class="ra-field-hint">Ainda não cadastrou? <a asp-controller="Items" asp-action="Create">Cadastre um item com fotos.</a></small>
            </div>
            <div class="form-group">
                <label asp-for="modelo">Modelo ou referência *</label>
                <input asp-for="modelo" class="form-control" maxlength="150" placeholder="Marca e modelo do item" required />
                <span asp-validation-for="modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Categoria">Categoria *</label>
                <select asp-items="ViewBag.Categoria" name="Categoria" id="Categoria" class="form-control" required>
                    <option value="">Escolha a categoria</option>
                </select>
            </div>
            <div class="form-group">
                <label for="Tipo">Tipo *</label>
                <select id="Tipo" name="Tipo" class="form-control" required disabled>
                    <option value="">Selecione primeiro a categoria</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="vlitem">Valor do aluguel por dia (R$) *</label>
                <input asp-for="vlitem" class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal" required />
                <span asp-validation-for="vlitem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="diasAluguel">Quantidade de dias disponíveis *</label>
                <input asp-for="diasAluguel" class="form-control" type="number" min="1" max="365" required />
                <span asp-validation-for="diasAluguel" class="text-danger"></span>
            </div>
        </div>

        <h2><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Região onde o item está disponível</h2>
        <p class="ra-field-hint">A pesquisa mostra a sua cidade e bairro; o endereço exato não precisa de ser exposto ao público.</p>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="Estado">Estado (UF) *</label>
                <select asp-for="Estado" id="txtEstado" class="form-control" data-region-uf required>
                    <option value="">Selecione o estado</option>
                    @foreach (var uf in LocationCatalog.States)
                    {
                        <option value="@uf.Code">@uf.Name (@uf.Code)</option>
                    }
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cidade">Cidade *</label>
                <input asp-for="Cidade" id="txtCidade" class="form-control" data-region-city list="ra-ad-cities" placeholder="Selecione ou escreva a cidade" required autocomplete="address-level2" />
                <datalist id="ra-ad-cities"></datalist>
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bairro">Bairro *</label>
                <input asp-for="Bairro" id="txtBairro" class="form-control" maxlength="120" required />
                <span asp-validation-for="Bairro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CEP">CEP *</label>
                <input asp-for="CEP" id="txtCep" class="form-control" inputmode="numeric" maxlength="9" placeholder="00000-000" required autocomplete="postal-code" />
                <small class="ra-field-hint">O CEP pode preencher automaticamente a cidade, o bairro e a UF.</small>
                <span asp-validation-for="CEP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rua">Rua *</label>
                <input asp-for="Rua" id="txtRua" class="form-control" required autocomplete="address-line1" />
                <span asp-validation-for="Rua" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Numero">Número (opcional)</label>
                <input asp-for="Numero" id="txtNumero" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="form-group ra-full">
                <label asp-for="Complemento">Complemento (opcional)</label>
                <input asp-for="Complemento" class="form-control" />
            </div>
        </div>
        <div class="ra-map-actions">
            <a href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark" data-region-map-link aria-disabled="true"><i class="fas fa-map-marked-alt" aria-hidden="true"></i> Ver região no Google Maps</a>
            <div class="ra-map-preview" data-ra-map hidden aria-label="Mapa aproximado da região selecionada"></div>
        </div>

        <h2><i class="fas fa-phone-alt" aria-hidden="true"></i> Contato</h2>
        <div class="ra-form-grid">
            <div class="form-group">
                <label asp-for="NomeFantasia">Como as pessoas devem chamar você? *</label>
                <input asp-for="NomeFantasia" class="form-control" required />
                <span asp-validation-for="NomeFantasia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="contato">Telefone ou outro contato *</label>
                <input asp-for="contato" class="form-control" required />
                <span asp-validation-for="contato" class="text-danger"></span>
            </div>
        </div>
        <div class="btn-container">
            <button type="submit" class="btn btn-primary"><i class="fas fa-check" aria-hidden="true"></i> Publicar anúncio</button>
            <a asp-action="Index" class="btn btn-outline-dark">Voltar para lista</a>
        </div>
    </form>
</div>
