@model aluguel.Models.Anuncio
@using aluguel.Services
@{ ViewData["Title"] = "Criar anúncio"; }
<div class="page-width"><div class="form-shell">
    <div class="page-intro">
        <div><p class="eyebrow">Publicar um artigo já cadastrado</p><h1>Prepara o teu anúncio</h1><p>Define onde está o artigo, o preço e como os interessados te podem contactar pela RentAll.</p></div>
        <a class="btn btn-outline" asp-controller="Items" asp-action="Index"><i class="fas fa-arrow-left"></i> Meus itens</a>
    </div>
    <div class="helper-banner"><i class="fas fa-shield-alt"></i><span>A localização pública será aproximada. A rua, o número e o código postal não aparecem nos detalhes do anúncio.</span></div>
    <form class="form-panel" asp-controller="Anuncios" asp-action="Create" method="post" data-submit-lock>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <h2><i class="fas fa-box-open" aria-hidden="true"></i> Artigo e condições</h2>
        <div class="form-grid">
            <div class="form-field full">
                <label asp-for="itemid">Artigo cadastrado *</label>
                <select asp-for="itemid" asp-items="ViewBag.itemid" class="form-select" required><option value="">Seleciona o artigo</option></select>
                <small>Não aparece? <a asp-controller="Publicar" asp-action="Index">Ou cria tudo numa página, sem passos separados.</a></small>
                <span asp-validation-for="itemid" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label for="Categoria">Categoria *</label>
                <select class="form-select" name="Categoria" id="Categoria" asp-items="ViewBag.Categoria" required><option value="">Seleciona a categoria</option></select>
            </div>
            <div class="form-field">
                <label for="Tipo">Tipo *</label>
                <select class="form-select" name="Tipo" id="Tipo" data-selected-type="@Model.tipoid" required disabled><option value="">Escolhe primeiro a categoria</option></select>
            </div>
            <div class="form-field full">
                <label asp-for="modelo">Marca / modelo / referência (opcional)</label>
                <input asp-for="modelo" class="form-control" placeholder="Ex.: Bosch GSB 13 RE" maxlength="150" />
                <span asp-validation-for="modelo" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="vlitem" data-rental-currency>Preço por dia (opcional)</label>
                <input asp-for="vlitem" class="form-control" type="number" step="0.01" min="0" max="10000000" />
                <span asp-validation-for="vlitem" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="diasAluguel">Dias disponíveis (opcional)</label>
                <input asp-for="diasAluguel" class="form-control" type="number" min="0" max="365" />
                <span asp-validation-for="diasAluguel" class="text-danger"></span>
            </div>
        </div>
        <h2><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Em que zona está o artigo?</h2>
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Pais">País *</label>
                <select asp-for="Pais" class="form-select" data-region-country required>
                    <option value="BR">Brasil</option><option value="PT">Portugal</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Estado" data-region-label>@LocationCatalog.RegionLabel(Model.Pais) *</label>
                <select asp-for="Estado" class="form-select" data-region-uf required>
                    <option value="">Escolhe a região</option>
                    @foreach (var region in LocationCatalog.RegionsFor(Model.Pais))
                    { <option value="@region.Code">@region.Name</option> }
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Cidade">Cidade / município *</label>
                <input asp-for="Cidade" class="form-control" data-region-city list="ad-cities" id="txtCidade" placeholder="Seleciona ou escreve a cidade" required />
                <datalist id="ad-cities"></datalist>
                <span asp-validation-for="Cidade" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Bairro">Bairro / freguesia (opcional)</label>
                <input asp-for="Bairro" class="form-control" id="txtBairro" />
                <span asp-validation-for="Bairro" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="CEP" data-postal-label>@LocationCatalog.PostalLabel(Model.Pais) (opcional)</label>
                <input asp-for="CEP" class="form-control" id="txtCep" placeholder="@(Model.Pais == "PT" ? "0000-000" : "00000-000")" maxlength="9" inputmode="numeric" />
                <span asp-validation-for="CEP" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Rua">Rua (opcional)</label>
                <input asp-for="Rua" class="form-control" id="txtRua" autocomplete="street-address" />
                <span asp-validation-for="Rua" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Numero">Número (opcional)</label>
                <input asp-for="Numero" class="form-control" id="txtNumero" />
            </div>
            <div class="form-field">
                <label asp-for="Complemento">Complemento (opcional)</label>
                <input asp-for="Complemento" class="form-control" />
            </div>
        </div>
        <div class="inline-map">
            <a class="btn btn-outline" data-region-map-link href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer"><i class="fas fa-map-marked-alt"></i> Ver localização aproximada no Maps</a>
            <div class="ra-map-preview" data-ra-map hidden aria-label="Mapa aproximado da região"></div>
        </div>
        <h2><i class="far fa-comments" aria-hidden="true"></i> Perfil público</h2>
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="NomeFantasia">Nome público (opcional)</label>
                <input asp-for="NomeFantasia" class="form-control" placeholder="Como gostarias de ser tratado?" />
                <span asp-validation-for="NomeFantasia" class="text-danger"></span>
            </div>
            
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit"><i class="fas fa-check"></i> Publicar anúncio</button><a asp-action="Index" class="btn btn-outline">Cancelar</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
