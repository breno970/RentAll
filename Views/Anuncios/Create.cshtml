@model aluguel.Models.Anuncio
@{ ViewData["Title"] = "Criar anúncio"; }
<div class="form-shell">
    <div class="page-heading"><div><div class="eyebrow">Meus anúncios / Novo</div><h1>Criar anúncio</h1><p>Escolha um dos seus itens e defina os detalhes do aluguel.</p></div><a class="btn btn-outline" asp-action="Index">← Voltar</a></div>
    <form asp-action="Create" method="post" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h2>O item e o aluguel</h2>
        <div class="form-grid">
            <div class="field full"><label asp-for="itemid">Item cadastrado *</label><select asp-for="itemid" asp-items="ViewBag.itemid" class="form-select" required><option value="">Selecione um item</option></select><small>Não encontrou um item? <a asp-controller="Items" asp-action="Create">Cadastre-o aqui.</a></small></div>
            <div class="field"><label asp-for="vlitem">Valor por dia (R$) *</label><input asp-for="vlitem" type="number" min="0.01" step="0.01" class="form-control" required /></div>
            <div class="field"><label asp-for="diasAluguel">Dias disponíveis *</label><input asp-for="diasAluguel" type="number" min="1" class="form-control" required /></div>
            <div class="field"><label for="Categoria">Categoria *</label><select name="Categoria" id="Categoria" data-category-select asp-items="ViewBag.Categoria" class="form-select" required><option value="">Selecione a categoria</option></select></div>
            <div class="field"><label for="Tipo">Tipo *</label><select name="Tipo" id="Tipo" data-type-select class="form-select" disabled required><option value="">Selecione primeiro a categoria</option></select></div>
            <div class="field full"><label asp-for="modelo">Modelo / referência *</label><input asp-for="modelo" class="form-control" required placeholder="Marca ou modelo do item" /></div>
        </div>
        <h2>Onde está o item?</h2>
        <div class="form-grid">
            <div class="field"><label asp-for="CEP">CEP *</label><input asp-for="CEP" id="txtCep" inputmode="numeric" maxlength="9" class="form-control" required placeholder="00000-000" /></div>
            <div class="field"><label asp-for="Estado">Estado (UF) *</label><input asp-for="Estado" id="txtEstado" maxlength="2" class="form-control" required placeholder="RJ" /></div>
            <div class="field"><label asp-for="Cidade">Cidade *</label><input asp-for="Cidade" id="txtCidade" class="form-control" required /></div>
            <div class="field"><label asp-for="Bairro">Bairro *</label><input asp-for="Bairro" id="txtBairro" class="form-control" required /></div>
            <div class="field full"><label asp-for="Rua">Rua *</label><input asp-for="Rua" id="txtRua" class="form-control" required /></div>
            <div class="field"><label asp-for="Numero">Número</label><input asp-for="Numero" id="txtNumero" class="form-control" /></div>
            <div class="field"><label asp-for="Complemento">Complemento</label><input asp-for="Complemento" class="form-control" /></div>
        </div>
        <h2>Contato</h2>
        <div class="form-grid">
            <div class="field"><label asp-for="NomeFantasia">Como quer ser chamado? *</label><input asp-for="NomeFantasia" class="form-control" required /></div>
            <div class="field"><label asp-for="contato">Telefone ou outro contato *</label><input asp-for="contato" class="form-control" required /></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Publicar anúncio</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
    </form>
</div>
