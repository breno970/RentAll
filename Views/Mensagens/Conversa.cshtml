@model aluguel.ViewModel.ConversaViewModel
@using aluguel.ViewModel
@{ ViewData["Title"] = "Conversa sobre " + Model.NomeArtigo; }
<link rel="stylesheet" href="~/css/marketplace-messages.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/in-platform-journey.css" asp-append-version="true" />
<div class="page-width ra-messages">
    <div class="page-intro">
        <div><p class="eyebrow"><a asp-action="Index">Mensagens</a> / Conversa</p>
            <h1>@Model.NomeArtigo</h1><p>@(Model.SouAnunciante ? "Conversa com pessoa interessada" : "Conversa com anunciante")</p>
        </div>
        <a class="btn btn-outline" asp-controller="Anuncios" asp-action="Details" asp-route-id="@Model.AnuncioId">Ver anúncio</a>
    </div>
    <section class="ra-chat-journey" aria-label="Próximo passo do aluguer">
        <div class="ra-journey-intro">
            <h2>Pedido de aluguer</h2>
        </div>
        @if (Model.PedidoId.HasValue)
        {
            <div class="ra-request-linked">
                <div><small>Pedido #@Model.PedidoId</small><strong>@(Model.EstadoPedido == "Aceite sem pagamento" ? RentalJourneyProgress.Label(Model.EtapaAluguer) : Model.EstadoPedido)</strong>
                    <p>@Model.DiasPedido @(Model.DiasPedido == 1 ? "dia" : "dias") · @aluguel.Services.RentalLocalization.FormatPrice((float)(Model.TotalPedido ?? 0), Model.Pais)</p>
                </div>
                @if (Model.EstadoPedido == "Aceite sem pagamento")
                {
                    <a class="btn btn-primary" asp-controller="PercursoDemo" asp-action="Detalhes"
                       asp-route-pedidoId="@Model.PedidoId">@RentalJourneyProgress.Action(Model.EtapaAluguer, Model.SouAnunciante)</a>
                }
                else
                {
                    <a class="btn btn-outline" asp-controller="Pedidos" asp-action="Index"
                       asp-route-pedido="@Model.PedidoId" asp-fragment="@($"pedido-{Model.PedidoId}")">Acompanhar pedido</a>
                }
            </div>
        }
        @if (!Model.SouAnunciante && Model.AnuncioAtivo && Model.PrecoDia > 0 &&
            (Model.PedidoId is null || Model.EstadoPedido is "Cancelado" or "Recusado"))
        {
            <form asp-controller="Pedidos" asp-action="Criar" method="post" class="ra-request-inline">
                <input type="hidden" name="anuncioId" value="@Model.AnuncioId" />
                <label for="chat-rental-days">Quantos dias precisas?
                    <input id="chat-rental-days" name="dias" type="number" min="1" max="@Model.PrazoMaximo" value="1" required class="form-control" />
                </label>
                <button class="btn btn-primary" type="submit">Enviar pedido de aluguer</button>
            </form>
        }
        else if (Model.PedidoId is null && Model.SouAnunciante)
        {
            <a class="btn btn-outline" asp-controller="Pedidos" asp-action="Index">Gerir pedidos recebidos</a>
        }
        else if (Model.PedidoId is null)
        {
            <p class="ra-journey-note">Podes continuar a conversar e combinar os próximos passos. O pedido formal depende de um anúncio ativo com preço definido.</p>
        }
    </section>
    <div class="ra-conversation">
        <div class="ra-safety-chat"><i class="fas fa-shield-alt" aria-hidden="true"></i> Combina a disponibilidade e a entrega nesta conversa. Mantém os teus contactos e dados bancários privados.</div>
            @if (Model.OlderThanId.HasValue || Model.ShowingOlderMessages)
            {
                <nav class="ra-chat-history-links" aria-label="Páginas de mensagens">
                    @if (Model.OlderThanId.HasValue)
                    {
                        <a asp-action="Conversa" asp-route-anuncioId="@Model.AnuncioId"
                           asp-route-peerId="@Model.OutroUtilizadorId" asp-route-antes="@Model.OlderThanId">Mensagens anteriores</a>
                    }
                    @if (Model.ShowingOlderMessages)
                    {
                        <a asp-action="Conversa" asp-route-anuncioId="@Model.AnuncioId"
                           asp-route-peerId="@Model.OutroUtilizadorId" asp-fragment="nova-mensagem">Mensagens recentes</a>
                    }
                </nav>
            }
        <div class="ra-chat-history" aria-label="Histórico da conversa" data-chat-recent="@(Model.ShowingOlderMessages ? null : "true")" tabindex="0">
            @if (!Model.Mensagens.Any())
            {
                <p class="ra-chat-empty">@(Model.ShowingOlderMessages ? "Sem mensagens anteriores." : "Diz olá e pergunta sobre a disponibilidade do artigo.")</p>
            }
            @foreach (var message in Model.Mensagens)
            {
                <article class="ra-chat-bubble @(message.RemetenteId == Model.MeuId ? "is-me" : "")">
                    <p>@message.Texto</p>
                    <time datetime="@message.CriadaEm.ToString("O")">@message.CriadaEm.ToString("dd/MM/yyyy HH:mm") UTC</time>
                </article>
            }
        </div>
        <form id="nova-mensagem" asp-action="Enviar" method="post" class="ra-chat-form" data-guarded-message-form data-submit-lock>
            <input type="hidden" name="anuncioId" value="@Model.AnuncioId" />
            <input type="hidden" name="peerId" value="@Model.OutroUtilizadorId" />
            <label for="messageText">A tua mensagem</label>
            <div class="ra-chat-prompts" aria-label="Sugestões de mensagem">
                <button type="button" data-chat-suggestion="Olá! O artigo está disponível para os dias que pretendo?" >Perguntar disponibilidade</button>
                <button type="button" data-chat-suggestion="Podemos combinar um local público para a entrega?" >Combinar entrega</button>
                <button type="button" data-chat-suggestion="Podes confirmar o estado do artigo e os acessórios incluídos?" >Confirmar condições</button>
            </div>
            @if (ViewBag.MessageError is string policyError)
            {
                <div class="ra-message-issue" role="alert">@policyError</div>
            }
            <textarea id="messageText" name="texto" required maxlength="2000" rows="3" class="form-control"
                aria-describedby="ra-message-policy" placeholder="Escreve aqui a tua pergunta sobre o artigo...">@ViewBag.UnsentMessage</textarea>
            <div class="ra-message-issue" role="alert" data-message-warning hidden></div>
            <small class="ra-chat-help" id="ra-message-policy">Não envies números de telemóvel, e-mail, links, redes sociais ou pedidos de pagamento externo. Se uma mensagem for recusada, podes corrigi-la. <a asp-controller="Termos" asp-action="Index">Ver regras de utilização</a>.</small>
            <button type="submit" class="btn btn-primary"><i class="far fa-paper-plane"></i> Enviar mensagem</button>
        </form>
    </div>
</div>
@section Scripts {<script src="~/js/in-platform-journey.js" asp-append-version="true"></script>}
