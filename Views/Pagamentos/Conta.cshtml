@{ViewData["Title"]="Pagamentos de teste";}
<div class="page-width" style="max-width:820px;padding:38px 0 72px">
 <div class="page-intro"><div><p class="eyebrow">RentAll · Stripe Connect</p><h1>Recebimentos</h1>
 <p>Verifica a tua conta de recebimento para futuros alugueres.</p></div></div>
 <div class="panel">
  <h2>Integração de pagamentos</h2>
  @if(ViewBag.Enabled != true) {
   <p>Os pagamentos estão desativados. Estamos a preparar o ambiente de teste com a Stripe; não serão cobrados valores reais.</p>
  } else if(ViewBag.Ready == true) {
   <p><i class="fas fa-check-circle"></i> Conta de teste verificada para receber transferências.</p>
  } else {
   <p>@(ViewBag.Connected == true ? "A tua conta de teste ainda precisa de verificação." : "Liga uma conta de teste para simular recebimentos.")</p>
   <form asp-controller="Pagamentos" asp-action="Conectar" method="post">
      <button class="btn btn-primary" type="submit">@(ViewBag.Connected == true ? "Continuar verificação na Stripe" : "Ligar conta de teste Stripe")</button>
   </form>
  }
  <p class="muted" style="margin-top:16px">Este processo só usa o ambiente de testes. A verificação comercial e os pagamentos reais não estão disponíveis nesta fase.</p>
  <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline">Ver pedidos de aluguer</a>
 </div>
</div>