@{
    ViewData["Title"] = "Recebimentos na RentAll";
    var enabled = ViewBag.Enabled == true;
    var connected = ViewBag.Connected == true;
    var ready = ViewBag.Ready == true;
}
<link rel="stylesheet" href="~/css/stripe-sandbox.css" asp-append-version="true" />
<div class="page-width ra-billing">
    <header class="ra-billing-header">
        <p class="eyebrow">RentAll · Contas e pagamentos</p>
        <h1>Recebimentos</h1>
        <p>Prepara a tua conta para receber alugueres através da RentAll, sem partilhares dados bancários com outros utilizadores.</p>
    </header>
    <div class="ra-billing-status">
        <div class="ra-billing-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
        <div>
            <strong>@(enabled ? ready ? "Conta de teste preparada" : connected ? "Verificação de teste pendente" : "Verifica a conta de teste" : "Pagamentos ainda não disponíveis")</strong>
            <p>@(enabled ? "Esta funcionalidade opera exclusivamente com a sandbox Stripe. Não movimenta dinheiro real." : "A RentAll ainda não aceita pagamentos reais. Os anúncios, mensagens e pedidos continuam disponíveis.")</p>
        </div>
    </div>
    @if (enabled && !ready)
    {
        <div class="ra-billing-panel">
            <h2>Verifica a tua conta de teste</h2>
            <p>A Stripe recolhe diretamente os dados de verificação exigidos. A RentAll não recebe números de cartão nem documentos de identificação através deste formulário.</p>
            <form asp-controller="Pagamentos" asp-action="Conectar" method="post">
                <button class="btn btn-primary" type="submit">
                    @(connected ? "Continuar verificação" : "Iniciar verificação") <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    }
    <div class="ra-billing-steps">
        <div><span>01</span><div><strong>Publica um artigo</strong><p>Os anúncios continuam gratuitos e ativos por predefinição.</p></div></div>
        <div><span>02</span><div><strong>Recebe um pedido</strong><p>Confirma o preço e os dias antes de aceitar.</p></div></div>
        <div><span>03</span><div><strong>Pagamento seguro</strong><p>Checkout Stripe e divisão de 10% para a RentAll serão testados antes da ativação comercial.</p></div></div>
    </div>
    <p class="ra-billing-note"><i class="fas fa-info-circle" aria-hidden="true"></i> Não existe proteção financeira, seguro ou garantia de pagamento ativa. A comissão apresentada na RentAll é ilustrativa enquanto a cobrança real estiver desativada.</p>
    <a class="btn btn-outline" asp-controller="Pagamentos" asp-action="Demonstracao">Ver exemplo de pagamento com cartão</a>
    <a class="btn btn-outline" asp-controller="Pedidos" asp-action="Index">Voltar aos pedidos</a>
</div>