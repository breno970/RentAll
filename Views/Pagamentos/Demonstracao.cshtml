@model aluguel.ViewModel.CartaoDemoViewModel
@{
    ViewData["Title"] = "Demonstração completa de aluguer";
}
<link rel="stylesheet" href="~/css/payment-journey-demo.css" asp-append-version="true" />
<div class="page-width ra-checkout-example ra-complete-demo" data-payment-example data-rate-centimos="@Model.PrecoDiaCentimos">
    <div class="ra-demo-head">
        <div>
            <p class="eyebrow">RentAll · Demonstração interativa</p>
            <h1>Alugar @Model.Artigo</h1>
            <p>Experimenta os dois papéis na mesma sessão, do pagamento simulado à confirmação da receção.</p>
        </div>
        <a class="btn btn-outline" asp-controller="Home" asp-action="Exemplos">Escolher outro artigo</a>
    </div>
    <div class="ra-demo-warning" role="note">
        <strong>Ambiente de demonstração — esta experiência é simulada, não cobra dinheiro e não recolhe dados bancários.</strong>
        As datas, a entrega e o comprovativo são exemplos sem validade fiscal.
    </div>
    <ol class="ra-demo-steps" aria-label="Etapas da demonstração">
        <li data-demo-step="0" aria-current="step">1. Acordo</li>
        <li data-demo-step="1">2. Checkout</li>
        <li data-demo-step="2">3. Pagamento</li>
        <li data-demo-step="3">4. Combinar entrega</li>
        <li data-demo-step="4">5. Entregar</li>
        <li data-demo-step="5">6. Utilização</li>
        <li data-demo-step="6">7. Devolver</li>
        <li data-demo-step="7">8. Concluir</li>
    </ol>
    <p class="ra-demo-alert" data-demo-error hidden role="alert"></p>
    <div class="ra-demo-main">
        <div class="ra-demo-sections">
            <section class="ra-demo-box" data-demo-screen="0" aria-labelledby="ra-demo-agreement">
                <span class="ra-demo-tag">ETAPA 1 DE 8 · ACORDO</span>
                <h2 id="ra-demo-agreement" tabindex="-1">Confirmar o aluguer</h2>
                <p>Escolhe os dias de recolha e devolução. O preço é calculado por dia, até 30 dias.</p>
                <div class="ra-demo-period">
                    <label>Recolha <input class="form-control" type="date" data-demo-pickup required /></label>
                    <label>Devolução <input class="form-control" type="date" data-demo-dropoff required /></label>
                </div>
                <dl class="ra-demo-order" aria-live="polite">
                    <div><dt>Preço por dia</dt><dd data-demo-rate-label>—</dd></div>
                    <div><dt>Duração</dt><dd data-demo-days>—</dd></div>
                    <div class="ra-demo-total"><dt>Total simulado</dt><dd data-demo-total>—</dd></div>
                </dl>
                <label class="ra-demo-agreement">
                    <input type="checkbox" data-demo-ack />
                    <span>Compreendo que todos os pagamentos, confirmações de entrega, avisos e avaliações aqui apresentados são fictícios.</span>
                </label>
                <button class="btn btn-primary" type="button" data-demo-next>Avançar para checkout</button>
            </section>

            <section class="ra-demo-box" data-demo-screen="1" aria-labelledby="ra-demo-payment" hidden>
                <span class="ra-demo-tag">ETAPA 2 DE 8 · CHECKOUT</span>
                <h2 id="ra-demo-payment" tabindex="-1">Escolher o método de pagamento</h2>
                <p>Confirma o total e escolhe como queres simular o pagamento.</p>
                <dl class="ra-demo-order"><div class="ra-demo-total"><dt>Total simulado</dt><dd data-demo-total>—</dd></div></dl>
                <div class="ra-demo-methods" role="group" aria-label="Selecionar método demonstrativo">
                    <button type="button" data-demo-method="card" aria-pressed="true" class="is-selected">Cartão de débito ou crédito</button>
                    <button type="button" data-demo-method="mbway" aria-pressed="false">MB WAY (apenas ilustrativo)</button>
                </div>
                <div class="ra-demo-fake-card" data-demo-card aria-label="Cartão fictício não editável">
                    <small>MEIO DE PAGAMENTO FICTÍCIO · SEM DADOS REAIS</small>
                    <strong>•••• &nbsp; •••• &nbsp; •••• &nbsp; 4242</strong>
                    <span>Validade ••/•• &nbsp; Segurança •••</span>
                </div>
                <p class="ra-demo-method-info" data-demo-method-info>Não introduzas dados de cartão: a RentAll não os recolhe nesta demonstração.</p>
                <div class="ra-demo-controls">
                    <button class="btn btn-primary" type="button" data-demo-authorize>Simular pagamento aprovado</button>
                    <button class="btn btn-outline" type="button" data-demo-decline>Simular pagamento recusado</button>
                    <button class="btn btn-outline" type="button" data-demo-back>Voltar ao acordo</button>
                </div>
            </section>

            <section class="ra-demo-box" data-demo-screen="2" aria-labelledby="ra-demo-payment-result" hidden>
                <span class="ra-demo-tag">ETAPA 3 DE 8 · RESULTADO</span>
                <h2 id="ra-demo-payment-result" tabindex="-1">Resposta do checkout</h2>
                <div class="ra-demo-result" data-demo-result role="status">
                    <strong data-demo-result-title></strong>
                    <p data-demo-result-text></p>
                </div>
                <div class="ra-demo-receipt">
                    <strong>Registo ilustrativo — sem valor contabilístico</strong>
                    <dl class="ra-demo-order">
                        <div><dt>Artigo</dt><dd>@Model.Artigo</dd></div>
                        <div><dt>Total demonstrativo</dt><dd><span data-demo-total>—</span></dd></div>
                        <div><dt>Comissão de exemplo RentAll</dt><dd><span data-demo-fee>—</span></dd></div>
                        <div><dt>Cobrado na realidade</dt><dd>0,00 €</dd></div>
                    </dl>
                </div>
                <div class="ra-demo-controls">
                    <button class="btn btn-primary" type="button" data-demo-after-pay>Combinar a entrega</button>
                    <button class="btn btn-outline" type="button" data-demo-retry>Tentar novamente</button>
                </div>
            </section>

            <section class="ra-demo-box" data-demo-screen="3" aria-labelledby="ra-demo-delivery" hidden>
                <span class="ra-demo-tag">ETAPA 4 DE 8 · LOGÍSTICA</span>
                <h2 id="ra-demo-delivery" tabindex="-1">Combinar como será entregue</h2>
                <p>O anunciante propõe a entrega e o locatário aceita. Alterna entre os papéis para demonstrares a colaboração na plataforma.</p>
                <div class="ra-demo-role"><span>Anunciante</span><strong>1. Propor condições</strong></div>
                <form data-demo-delivery-form class="ra-demo-delivery-form" novalidate>
                    <label>Modalidade de entrega
                        <select class="form-select" data-demo-delivery-kind required>
                            <option value="em_maos">Entrega em mãos num local público</option>
                            <option value="ponto_recolha">Ponto de recolha combinado</option>
                            <option value="transportadora">Transportadora (apenas simulação)</option>
                        </select>
                    </label>
                    <label>Local público ou ponto de recolha
                        <input class="form-control" type="text" data-demo-delivery-place minlength="3" maxlength="120" placeholder="Ex.: estação em @Model.Cidade" autocomplete="off" required />
                    </label>
                    <label>Data e hora propostas
                        <input class="form-control" type="datetime-local" data-demo-delivery-time required />
                    </label>
                    <p class="ra-demo-hint">Não coloques uma morada privada. Não é solicitada recolha nem envio real.</p>
                    <button class="btn btn-outline" type="submit">Propor entrega como anunciante</button>
                </form>
                <div class="ra-demo-proposal" data-demo-proposal hidden>
                    <div class="ra-demo-role"><span>Locatário</span><strong>2. Aceitar proposta</strong></div>
                    <p data-demo-proposal-text></p>
                    <button class="btn btn-primary" type="button" data-demo-confirm-delivery>Confirmar condições de entrega como locatário</button>
                </div>
                <div class="ra-demo-controls">
                    <button class="btn btn-outline" type="button" data-demo-refund>Simular cancelamento e reembolso</button>
                </div>
            </section>

            <section class="ra-demo-box" data-demo-screen="4" aria-labelledby="ra-demo-handover" hidden>
                <span class="ra-demo-tag">ETAPA 5 DE 8 · ENTREGA</span>
                <h2 id="ra-demo-handover" tabindex="-1">Registar a entrega do artigo</h2>
                <p data-demo-delivery-review></p>
                <label class="ra-demo-agreement"><input type="checkbox" data-demo-handover-check />
                    <span>O artigo, os acessórios e o respetivo estado foram verificados nesta simulação.</span>
                </label>
                <p>Para avançar, cada participante confirma separadamente. Não existe entrega, verificação presencial ou assinatura real.</p>
                <div class="ra-demo-party-grid">
                    <div><strong>Anunciante</strong><p data-demo-handover-owner>Por confirmar</p><button type="button" class="btn btn-outline" data-demo-handover="owner">Confirmar entrega</button></div>
                    <div><strong>Locatário</strong><p data-demo-handover-renter>Por confirmar</p><button type="button" class="btn btn-primary" data-demo-handover="renter">Confirmar receção do artigo</button></div>
                </div>
            </section>

            <section class="ra-demo-box" data-demo-screen="5" aria-labelledby="ra-demo-active" hidden>
                <span class="ra-demo-tag">ETAPA 6 DE 8 · ALUGUER EM CURSO</span>
                <h2 id="ra-demo-active" tabindex="-1">Artigo recebido na simulação</h2>
                <div class="ra-demo-result"><strong>Entrega confirmada pelos dois participantes</strong><p>Nesta demonstração, o artigo está agora na posse do locatário. O histórico abaixo apresenta notificações ilustrativas.</p></div>
                <div class="ra-demo-controls">
                    <button class="btn btn-primary" type="button" data-demo-start-return>Iniciar devolução</button>
                    <button class="btn btn-outline" type="button" data-demo-report-incident>Simular problema com o artigo</button>
                    <button class="btn btn-outline" type="button" data-demo-resolve-incident hidden>Resolver ocorrência fictícia</button>
                </div>
                <p data-demo-incident-status role="status"></p>
            </section>

            <section class="ra-demo-box" data-demo-screen="6" aria-labelledby="ra-demo-return" hidden>
                <span class="ra-demo-tag">ETAPA 7 DE 8 · DEVOLUÇÃO</span>
                <h2 id="ra-demo-return" tabindex="-1">Confirmar a devolução</h2>
                <p>Devolução prevista para <strong data-demo-return-at>—</strong>, em <strong data-demo-place>—</strong>.</p>
                <label class="ra-demo-agreement"><input type="checkbox" data-demo-return-check />
                    <span>A devolução e o estado do artigo foram verificados apenas para esta demonstração.</span>
                </label>
                <div class="ra-demo-party-grid">
                    <div><strong>Locatário</strong><p data-demo-return-renter>Por confirmar</p><button type="button" class="btn btn-outline" data-demo-return="renter">Confirmar devolução</button></div>
                    <div><strong>Anunciante</strong><p data-demo-return-owner>Por confirmar</p><button type="button" class="btn btn-outline" data-demo-return="owner">Confirmar receção</button></div>
                </div>
                <div class="ra-demo-controls">
                    <button class="btn btn-outline" type="button" data-demo-report-incident>Simular problema na devolução</button>
                    <button class="btn btn-outline" type="button" data-demo-resolve-incident hidden>Resolver ocorrência fictícia</button>
                </div>
                <p data-demo-incident-status role="status"></p>
            </section>

            <section class="ra-demo-box" data-demo-screen="7" aria-labelledby="ra-demo-complete" hidden>
                <span class="ra-demo-tag">ETAPA 8 DE 8 · CONCLUSÃO</span>
                <h2 id="ra-demo-complete" tabindex="-1">Aluguer demonstrativo concluído</h2>
                <div class="ra-demo-result"><strong>Entrega e devolução confirmadas</strong><p>Todos os passos foram emulados. Nenhum artigo foi reservado e nenhum pagamento foi efetuado.</p></div>
                <div class="ra-demo-receipt" id="comprovativo-demo">
                    <strong>Comprovativo DEMO — não é fatura nem recibo fiscal</strong>
                    <dl class="ra-demo-order">
                        <div><dt>Artigo</dt><dd>@Model.Artigo</dd></div>
                        <div><dt>Referência</dt><dd data-demo-reference>—</dd></div>
                        <div><dt>Período</dt><dd data-demo-period-label>—</dd></div>
                        <div><dt>Local combinado</dt><dd data-demo-place>—</dd></div>
                        <div><dt>Devolução prevista</dt><dd data-demo-return-at>—</dd></div>
                        <div><dt>Pagamento ilustrativo</dt><dd><span data-demo-total>—</span></dd></div>
                        <div><dt>Comissão ilustrativa (10%)</dt><dd><span data-demo-fee>—</span></dd></div>
                        <div><dt>Recebimento do anunciante (hipotético)</dt><dd><span data-demo-owner-share>—</span></dd></div>
                        <div><dt>Valor realmente transacionado</dt><dd>0,00 €</dd></div>
                    </dl>
                </div>
                <label class="ra-demo-rating">Avaliar a experiência (não é publicada)
                    <select class="form-select" data-demo-rating><option value="">Escolhe uma nota</option><option value="1">1 — Muito fraca</option><option value="2">2 — Fraca</option><option value="3">3 — Razoável</option><option value="4">4 — Boa</option><option value="5">5 — Excelente</option></select>
                </label>
                <button class="btn btn-outline" type="button" data-demo-rate>Registar avaliação fictícia</button>
                <p data-demo-rating-result role="status"></p>
                <div class="ra-demo-controls">
                    <button class="btn btn-primary" type="button" data-demo-restart>Repetir a demonstração</button>
                    <button class="btn btn-outline" type="button" data-demo-print>Imprimir comprovativo</button>
                </div>
            </section>

            <section class="ra-demo-box" data-demo-screen="8" aria-labelledby="ra-demo-cancelled" hidden>
                <span class="ra-demo-tag">PERCURSO ALTERNATIVO · CANCELAMENTO</span>
                <h2 id="ra-demo-cancelled" tabindex="-1">Cancelamento e reembolso simulados</h2>
                <div class="ra-demo-result"><strong>Reembolso integral fictício</strong>
                    <p>O ciclo de cancelamento foi mostrado para efeitos de apresentação. Não houve captura de dinheiro, estorno, comunicação bancária nem alteração do pedido real.</p>
                </div>
                <dl class="ra-demo-order">
                    <div><dt>Valor demonstrativo</dt><dd><span data-demo-total>—</span></dd></div>
                    <div><dt>Reembolso emulado</dt><dd><span data-demo-total>—</span></dd></div>
                    <div><dt>Montante realmente movimentado</dt><dd>0,00 €</dd></div>
                </dl>
                <button class="btn btn-primary" type="button" data-demo-restart>Recomeçar demonstração</button>
            </section>
        </div>
        <aside class="ra-demo-sidebar-stack">
            <div class="ra-demo-box ra-demo-sidebar" aria-label="Resumo financeiro demonstrativo">

                <h2>Resumo do aluguer</h2>
                <div class="ra-demo-product">
                    @if (Model.Foto is not null)
                    {
                        <img src="~/catalogo/@Model.Foto" alt="" width="76" height="76" />
                    }
                    <div><strong class="ra-demo-item">@Model.Artigo</strong><br /><small>@Model.Cidade</small></div>
                </div>
                <dl class="ra-demo-order">
                    <div><dt>Período</dt><dd data-demo-period-label>—</dd></div>
                    <div><dt>Local de entrega</dt><dd data-demo-place>Por combinar</dd></div>
                    <div><dt>Devolução prevista</dt><dd data-demo-return-at>Por combinar</dd></div>
                    <div class="ra-demo-total"><dt>Total simulado</dt><dd data-demo-total>—</dd></div>
                    <div><dt>Comissão indicativa RentAll</dt><dd><span data-demo-fee>—</span></dd></div>
                    <div><dt>Parte do anunciante (hipotética)</dt><dd><span data-demo-owner-share>—</span></dd></div>
                    <div><dt>Transação real</dt><dd>0,00 €</dd></div>
                </dl>
                <p class="ra-demo-sidebar-note">A divisão é indicativa, antes de taxas, impostos, disputas e reembolsos. A Stripe não é chamada nesta página.</p>
            </div>
            <div class="ra-demo-box ra-demo-history">
                <h2>Atividade e notificações <small>simuladas</small></h2>
                <ol data-demo-history aria-live="polite"></ol>
                <p>Este histórico é temporário e desaparece ao atualizar a página. Não são enviados emails nem notificações reais.</p>
            </div>
        </aside>
    </div>
</div>
@section Scripts {
    <script src="~/js/payment-demo-flow.js" asp-append-version="true" defer></script>
    <script src="~/js/payment-demo.js" asp-append-version="true" defer></script>
}
