@using Microsoft.AspNetCore.Identity
@using aluguel.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link rel="shortcut icon" href="@Url.Content("~/imagens/ico.png")" type="image/x-icon" />
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#23232e" />
    <title>@(ViewData["Title"] ?? "Início") - RentAll</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive-improvements.css" asp-append-version="true" />
   
    <script src="https://kit.fontawesome.com/f9a4013b2c.js" crossorigin="anonymous"></script>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3045181554995684"
            crossorigin="anonymous"></script>


</head>
<body>

    <nav aria-label="Navegação principal">


        <div class="nave">

            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RentAll - página inicial"> <img src="~/imagens/ra.png" class="logo-img" alt="RentAll" /></a>

            <button class="mobile-menu" type="button" aria-expanded="false" aria-controls="rentall-navigation" aria-label="Abrir menu">
                <span class="line1" aria-hidden="true"></span>
                <span class="line2" aria-hidden="true"></span>
                <span class="line3" aria-hidden="true"></span>
            </button>

            <ul class="nav-list" id="rentall-navigation">
                <li class="nav">
                    <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Privacy">Sobre nós</a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                { }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                    </li>
                }
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-area="" asp-controller="Items" asp-action="Index">Meus Itens</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-area="" asp-controller="Anuncios" asp-action="Index">Meus Anúncios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-area="" asp-controller="Favoritos" asp-action="Index"><i class="far fa-heart" aria-hidden="true"></i> Favoritos</a>
                    </li>

                    <li class="nav-item">
                        <a id="manage" class="nav-link text-white-50" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                            <i class="fas fa-user"></i>Sua Conta
                        </a>
                    </li>

                    <li class="nav-item">
                        <form class="nav-link text-white-50" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-link" aria-label="Sair da conta" title="Sair"><i class="fas fa-sign-out-alt" aria-hidden="true"></i></button>
                        </form>
                    </li>

                }
            </ul>
        </div>

    </nav>


    <div class="container">


        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/cep.js" asp-append-version="true"></script>
    <script src="~/js/cadastro.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/mobile-navbar.js" asp-append-version="true"></script>
    <script src="~/js/regions.js" asp-append-version="true"></script>
    <script src="~/js/google-maps.js" asp-append-version="true"></script>
    @if (!string.IsNullOrWhiteSpace(Configuration["GoogleMaps:BrowserApiKey"]))
    {
        <script async src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:BrowserApiKey"]&amp;loading=async&amp;callback=rentallGoogleMapsReady"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
