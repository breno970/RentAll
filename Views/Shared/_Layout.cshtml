@using Microsoft.AspNetCore.Identity
@using aluguel.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var currentPath = Context.Request.Path.Value ?? "";
    var currentCountry = Context.Request.Query["Pais"].ToString() == "PT" ? "PT" : "BR";
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153d32" />
    <meta name="description" content="RentAll: aluga artigos que já existem. Encontra equipamentos, ferramentas e objetos em desuso no Brasil e em Portugal." />
    <title>@(ViewData["Title"] ?? "Descobrir artigos") | RentAll</title>
    <link rel="icon" href="@Url.Content("~/imagens/ico.png")" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rentall-2026.css" asp-append-version="true" />
    <script defer src="https://kit.fontawesome.com/f9a4013b2c.js" crossorigin="anonymous"></script>
</head>
<body class="rentall-app">
    <a class="skip-link" href="#main-content">Ir para o conteúdo principal</a>
    <div class="app-frame">
        <header class="site-header">
            <div class="header-inner page-width">
                <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RentAll, início">
                    <img src="~/imagens/ra.png" width="250" height="48" alt="RentAll" />
                </a>
                <nav id="main-navigation" class="site-nav" aria-label="Navegação principal">
                    <a class="nav-link @(currentPath.StartsWith("/Home") || currentPath == "/" ? "is-current" : "")"
                        asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-compass" aria-hidden="true"></i> Explorar</a>
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="fas fa-leaf" aria-hidden="true"></i> Como funciona</a>
                    @if (signedIn)
                    {
                        <a class="nav-link" asp-area="" asp-controller="Favoritos" asp-action="Index"><i class="far fa-heart" aria-hidden="true"></i> Favoritos</a>
                        <a class="nav-link" asp-area="" asp-controller="Items" asp-action="Index"><i class="fas fa-box" aria-hidden="true"></i> Meus itens</a>
                        <a class="nav-link" asp-area="" asp-controller="Anuncios" asp-action="Index"><i class="fas fa-list-alt" aria-hidden="true"></i> Anúncios</a>
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="far fa-user" aria-hidden="true"></i> Conta</a>
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button class="nav-logout" type="submit"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Sair</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login"><i class="far fa-user" aria-hidden="true"></i> Entrar</a>
                    }
                </nav>
                <div class="header-actions">
                    <a class="btn btn-brand header-cta" asp-area="" asp-controller="Items" asp-action="Create">
                        <i class="fas fa-plus" aria-hidden="true"></i> Anunciar item
                    </a>
                    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="main-navigation" aria-expanded="false" data-menu-toggle>
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </div>
        </header>

        <main id="main-content" class="main-content">
            @if (TempData["Success"] is string success)
            {
                <div class="page-width notice notice-success" role="status"><i class="fas fa-check-circle" aria-hidden="true"></i><span>@success</span><button class="notice-close" type="button" data-dismiss-parent aria-label="Fechar aviso"><i class="fas fa-times"></i></button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="page-width notice notice-danger" role="alert"><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span>@error</span><button class="notice-close" type="button" data-dismiss-parent aria-label="Fechar aviso"><i class="fas fa-times"></i></button></div>
            }
            @RenderBody()
        </main>
        <footer class="site-footer">
            <div class="page-width footer-main">
                <div class="footer-about">
                    <a class="footer-logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RentAll, início"><img src="~/imagens/ra.png" width="220" height="43" alt="RentAll" /></a>
                    <p>Mais uso, menos desperdício. Uma plataforma para dar novas oportunidades aos objetos que já temos.</p>
                    <div class="social-links" aria-label="Redes sociais">
                        <a href="https://github.com/RentAllBN" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fab fa-github" aria-hidden="true"></i></a>
                        <a href="https://www.instagram.com/rent.all._/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
                        <a href="https://twitter.com/RentAll_com" target="_blank" rel="noopener noreferrer" aria-label="X"><i class="fab fa-twitter" aria-hidden="true"></i></a>
                        <a href="https://www.linkedin.com/in/rent-all-0576ab268/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a>
                    </div>
                </div>
                <div class="footer-links">
                    <h2>Explorar</h2>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Todos os artigos</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Como funciona</a>
                    <a asp-area="" asp-controller="Termos" asp-action="Index">Termos de utilização</a>
                    <a asp-area="" asp-controller="Favoritos" asp-action="Index">Favoritos</a>
                </div>
                <div class="footer-links">
                    <h2>A minha conta</h2>
                    <a asp-area="" asp-controller="Items" asp-action="Create">Publicar um artigo</a>
                    <a asp-area="" asp-controller="Items" asp-action="Index">Meus itens</a>
                    <a asp-area="" asp-controller="Anuncios" asp-action="Index">Meus anúncios</a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">Definições de conta</a>
                </div>
                <div class="footer-contact">
                    <h2>Contactos</h2>
                    <a href="mailto:rent.all.bn@gmail.com"><i class="far fa-envelope" aria-hidden="true"></i> rent.all.bn@gmail.com</a>
                    <a href="tel:+5524999656679"><i class="fas fa-phone-alt" aria-hidden="true"></i> +55 24 99965-6679</a>
                    <a href="https://api.whatsapp.com/send?phone=5524999656679" target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp" aria-hidden="true"></i> Falar pelo WhatsApp</a>
                    <a href="https://goo.gl/maps/7QMZjZMJ355Z2Z9J6" target="_blank" rel="noopener noreferrer"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Visconde de Mauá, RJ · Brasil</a>
                </div>
            </div>
            <div class="footer-bottom page-width"><span>© @DateTime.UtcNow.Year RentAll. Todos os direitos reservados.</span><span>Aluga. Partilha. Reutiliza.</span></div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/regions.js" asp-append-version="true" defer></script>
    <script src="~/js/cep.js" asp-append-version="true" defer></script>
    <script src="~/js/rentall-ui.js" asp-append-version="true" defer></script>
    <script src="~/js/google-maps.js" asp-append-version="true" defer></script>
    @if (!string.IsNullOrWhiteSpace(Configuration["GoogleMaps:BrowserApiKey"]))
    {
        <script async src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:BrowserApiKey"]&amp;loading=async&amp;callback=rentallGoogleMapsReady"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
