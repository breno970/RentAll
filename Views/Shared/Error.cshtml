@model ErrorViewModel
@{ ViewData["Title"] = "Algo não correu bem"; }
<div class="page-width">
    <div class="error-page panel">
        <span class="error-icon"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></span>
        <h1>Não foi possível abrir esta página.</h1>
        <p class="muted">Ocorreu um problema inesperado. Experimenta novamente ou volta à página inicial.</p>
        @if (Model?.ShowRequestId == true)
        { <p class="muted" style="font-size:.76rem">Referência de suporte: <code>@Model.RequestId</code></p> }
        <div class="form-actions" style="justify-content:center"><a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Voltar ao início</a></div>
    </div>
</div>
