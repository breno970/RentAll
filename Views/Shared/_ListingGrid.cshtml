@model IEnumerable<aluguel.Models.Anuncio>
@if (!Model.Any())
{
    <div class="empty-state">
        <span class="empty-icon" aria-hidden="true">⌕</span>
        <h2>Nenhum anúncio encontrado</h2>
        <p>Experimente outra palavra-chave ou explore mais categorias para encontrar o que precisa.</p>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ver todos os anúncios</a>
    </div>
}
else
{
    <div class="listing-grid">
        @foreach (var anuncio in Model)
        {
            <article class="listing-card">
                <a asp-area="" asp-controller="Anuncios" asp-action="Details" asp-route-id="@anuncio.id" class="listing-image" aria-label="Ver detalhes de @(anuncio.item?.nmitem ?? "anúncio")">
                    @if (!string.IsNullOrEmpty(anuncio.item?.imagem1))
                    {
                        <img src="@Url.Content("~/imagens/" + anuncio.item.imagem1)" alt="@(anuncio.item?.nmitem ?? "Produto disponível")" loading="lazy" />
                    }
                    else
                    {
                        <span class="image-placeholder" aria-hidden="true">◇</span>
                    }
                </a>
                <div class="listing-body">
                    <div class="listing-meta"><span>⌁ @anuncio.Cidade, @anuncio.Estado</span><span>·</span><span>@(anuncio.categoria?.nmcategoria ?? "Aluguel")</span></div>
                    <h3 class="listing-title"><a asp-area="" asp-controller="Anuncios" asp-action="Details" asp-route-id="@anuncio.id">@(anuncio.item?.nmitem ?? anuncio.modelo)</a></h3>
                    <p class="listing-description">@(anuncio.item?.dsitem ?? anuncio.modelo)</p>
                    <div class="listing-bottom">
                        <div class="listing-price">R$ @anuncio.vlitem.ToString("N2", new System.Globalization.CultureInfo("pt-BR")) <small>/dia</small></div>
                        <a class="btn btn-secondary" asp-area="" asp-controller="Anuncios" asp-action="Details" asp-route-id="@anuncio.id">Detalhes</a>
                    </div>
                </div>
            </article>
        }
    </div>
}
