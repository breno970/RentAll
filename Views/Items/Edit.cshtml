@model aluguel.Models.Item
@{ ViewData["Title"] = "Editar item"; }
<div class="page-width"><div class="form-shell">
    <div class="page-intro"><div><p class="eyebrow">Meus itens / Edição</p><h1>Editar artigo</h1><p>Atualiza os dados e a visibilidade de <strong>@Model.nmitem</strong>.</p></div><a class="btn btn-outline" asp-action="Index"><i class="fas fa-arrow-left"></i> Voltar</a></div>
    <form asp-action="Edit" method="post" class="form-panel" data-submit-lock>
        <input asp-for="id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-grid">
            <div class="form-field full"><label asp-for="nmitem">Nome do artigo *</label><input asp-for="nmitem" class="form-control" required /><span asp-validation-for="nmitem" class="text-danger"></span></div>
            <div class="form-field full"><label asp-for="dsitem">Descrição *</label><textarea asp-for="dsitem" rows="5" class="form-control" required></textarea><span asp-validation-for="dsitem" class="text-danger"></span></div>
            <div class="form-field full"><label asp-for="snativo">Visibilidade</label><select asp-for="snativo" class="form-select"><option value="S">Ativo</option><option value="N">Oculto</option></select></div>
        </div>
        <div class="helper-banner"><i class="fas fa-images"></i><span>As fotografias atuais permanecem guardadas. Para publicar o artigo, utiliza a opção «Anunciar» na tua lista.</span></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Guardar alterações</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
    </form>
</div></div>
