@model aluguel.Models.Item
@{ ViewData["Title"] = "Editar item"; }
<div class="form-shell">
    <div class="page-heading"><div><div class="eyebrow">Meus itens / Edição</div><h1>Editar item</h1><p>Atualize as informações e a visibilidade do objeto.</p></div><a asp-action="Index" class="btn btn-outline">← Voltar</a></div>
    <form asp-action="Edit" method="post" class="form-card">
        <input asp-for="id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div class="field full"><label asp-for="nmitem">Nome do item *</label><input asp-for="nmitem" class="form-control" required /><span asp-validation-for="nmitem" class="text-danger"></span></div>
            <div class="field full"><label asp-for="dsitem">Descrição *</label><textarea asp-for="dsitem" rows="5" class="form-control" required></textarea><span asp-validation-for="dsitem" class="text-danger"></span></div>
            <div class="field full"><label asp-for="snativo">Visibilidade</label><select asp-for="snativo" class="form-select"><option value="S">Ativo</option><option value="N">Oculto</option></select></div>
        </div>
        <div class="alert-soft" style="margin-top:22px">As fotografias atuais são mantidas. A substituição das imagens não está disponível nesta edição.</div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Guardar alterações</button><a asp-action="Index" class="btn btn-outline">Cancelar</a></div>
    </form>
</div>
