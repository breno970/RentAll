@model aluguel.Models.Item
@{
    ViewData["Title"] = "Editar item";
    var existing = new[] { Model.imagem1, Model.imagem2, Model.imagem3, Model.imagem4, Model.imagem5 }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}
<link rel="stylesheet" href="~/css/caditem.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/item-photos.css" asp-append-version="true" />
<div class="card-it">
    <h1>Editar item</h1>
    <form asp-action="Edit" asp-route-id="@Model.id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group"><label asp-for="nmitem">Nome</label><input asp-for="nmitem" class="form-control" required /></div>
        <div class="form-group"><label asp-for="dsitem">Descrição</label><textarea asp-for="dsitem" class="form-control" required></textarea></div>
        <div class="form-group"><label asp-for="snativo">Ativo?</label>
            <select asp-for="snativo" class="form-control"><option value="S">Sim</option><option value="N">Não</option></select>
        </div>
        <section class="photo-picker" data-photo-picker>
        @foreach (var image in existing) {
            <img data-existing-photo="@image" src="@Url.Content("~/imagens/" + image)" alt="" hidden />
        }
  <div class="photo-picker-controls">
    <button type="button" data-photo-add>Adicionar fotografias</button>
    <span data-photo-count>0 / 5 fotografias</span>
  </div>
  <input type="file" name="photos" data-photo-input accept="image/jpeg,image/png,image/webp" multiple hidden />
  <div class="photo-navigation">
    <button type="button" data-photo-prev aria-label="Fotografia anterior">‹</button>
    <div class="photo-stage" data-photo-stage aria-live="polite"></div>
    <button type="button" data-photo-next aria-label="Fotografia seguinte">›</button>
  </div>
  <p class="photo-error" data-photo-error role="alert"></p>
</section>
        <button type="submit" class="btn btn-primary">Guardar alterações</button>
        <a asp-action="Index">Voltar à lista</a>
    </form>
</div>
@section Scripts {
    <script src="~/js/item-photos.js" asp-append-version="true"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}