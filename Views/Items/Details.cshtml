@model aluguel.Models.Item
@{
    ViewData["Title"] = "Detalhes do item";
    var photos = new[] { Model.imagem1, Model.imagem2, Model.imagem3, Model.imagem4, Model.imagem5 }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}
<link rel="stylesheet" href="~/css/caditem.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/item-photos.css" asp-append-version="true" />
<div class="card-it">
    <h1>@Model.nmitem</h1>
    <div class="photo-picker">
        <div id="detailsPhotoCarousel" class="photo-navigation">
            <button type="button" id="detailsPrev" aria-label="Fotografia anterior">‹</button>
            <div class="photo-stage"><img id="detailsImage" class="photo-preview-image" alt="Fotografia do item" /><p id="detailsCount" class="photo-position"></p></div>
            <button type="button" id="detailsNext" aria-label="Fotografia seguinte">›</button>
        </div>
    </div>
    <p><strong>Descrição:</strong> @Model.dsitem</p>
    <p><strong>Data de criação:</strong> @Model.dtcriacao</p>
    <p><strong>Ativo:</strong> @(Model.snativo == "S" ? "Sim" : "Não")</p>
    <a asp-action="Index">Voltar à lista</a>
</div>
@section Scripts {
<script>
(() => {
  const photos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(photos.Select(x => Url.Content("~/imagens/" + x))));
  if (!photos.length) return;
  let current = 0;
  const img = document.getElementById('detailsImage');
  const count = document.getElementById('detailsCount');
  const draw = () => { img.src = photos[current]; count.textContent = (current + 1) + ' / ' + photos.length; };
  document.getElementById('detailsPrev').addEventListener('click', () => { current = (current - 1 + photos.length) % photos.length; draw(); });
  document.getElementById('detailsNext').addEventListener('click', () => { current = (current + 1) % photos.length; draw(); });
  draw();
})();
</script>
}