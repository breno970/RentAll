@model aluguel.Models.Item
@{ ViewData["Title"] = Model.nmitem; }
<div class="page-width">
    <div class="page-intro"><div><p class="eyebrow">Meus itens / Detalhes</p><h1>@Model.nmitem</h1><p>Consulta os dados do teu artigo.</p></div><a asp-action="Index" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Voltar</a></div>
    <div class="detail-layout">
        <div class="panel">
            @if (!string.IsNullOrWhiteSpace(Model.imagem1))
            { <img class="detail-main-image" src="@Url.Content("~/imagens/" + Model.imagem1)" alt="@Model.nmitem" /> }
            else { <div class="detail-main-image image-empty"><i class="far fa-image"></i></div> }
            <div class="gallery-thumbs">
                @foreach (var photo in new[] { Model.imagem2, Model.imagem3, Model.imagem4, Model.imagem5 }.Where(p => !string.IsNullOrWhiteSpace(p)))
                { <img src="@Url.Content("~/imagens/" + photo)" width="75" height="65" alt="Fotografia adicional de @Model.nmitem" loading="lazy" style="object-fit:cover;border-radius:10px" /> }
            </div>
        </div>
        <div class="panel">
            <span class="pill @(Model.snativo == "N" ? "pill-warning" : "")">@(Model.snativo == "N" ? "Oculto" : "Ativo")</span>
            <h1 class="detail-name" style="margin-top:14px">@Model.nmitem</h1>
            <h2 style="font-size:1rem;margin-top:24px">Descrição</h2>
            <p class="detail-description">@Model.dsitem</p>
            <div class="detail-facts">
                <div><small>Cadastrado</small><strong>@Model.dtcriacao.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Estado</small><strong>@(Model.snativo == "N" ? "Oculto" : "Ativo")</strong></div>
            </div>
            <div class="form-actions">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id"><i class="fas fa-pen"></i> Editar artigo</a>
                @if (Model.snativo != "N")
                { <a class="btn btn-outline" asp-controller="Anuncios" asp-action="Create" asp-route-itemId="@Model.id">Criar anúncio</a> }
            </div>
        </div>
    </div>
</div>
