@model aluguel.Models.Item
@{ ViewData["Title"] = "Detalhes do item"; }
<div class="page-heading"><div><div class="eyebrow">Meus itens / Detalhes</div><h1>@Model.nmitem</h1><p>Informações do seu item cadastrado.</p></div><a asp-action="Index" class="btn btn-outline">← Meus itens</a></div>
<div class="detail-layout">
    <div class="detail-card">
        @if (!string.IsNullOrWhiteSpace(Model.imagem1))
        { <img class="detail-image" src="@Url.Content("~/imagens/" + Model.imagem1)" alt="@Model.nmitem" /> }
        else { <div class="detail-image image-placeholder">◇</div> }
    </div>
    <div class="detail-panel">
        <span class="badge-pill @(Model.snativo == "N" ? "off" : "")">@(Model.snativo == "N" ? "Oculto" : "Ativo")</span>
        <h1>@Model.nmitem</h1>
        <h3>Descrição</h3>
        <p class="description">@Model.dsitem</p>
        <div class="detail-info"><div><small>Cadastrado em</small><strong>@Model.dtcriacao.ToString("dd/MM/yyyy")</strong></div><div><small>Fotografias</small><strong>Até 5 imagens</strong></div></div>
        <div class="form-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id">Editar item</a><a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.id">Excluir</a></div>
    </div>
</div>
