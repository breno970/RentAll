@model aluguel.Models.Item
@{ ViewData["Title"] = "Excluir item"; }
<div class="page-width"><div class="form-shell">
    <div class="page-intro"><div><p class="eyebrow">Meus itens / Exclusão</p><h1>Excluir artigo</h1><p>Confirma que pretendes apagar este artigo.</p></div></div>
    <div class="panel danger-panel">
        <span class="danger-icon"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></span>
        <h2>Excluir «@Model.nmitem»?</h2>
        <p class="muted">Esta ação é permanente. Os anúncios associados ao artigo poderão também ser afetados.</p>
        <form asp-action="Delete" method="post" data-submit-lock>
            <input asp-for="id" type="hidden" />
            <div class="form-actions"><button type="submit" class="btn btn-danger"><i class="far fa-trash-alt"></i> Sim, excluir artigo</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
        </form>
    </div>
</div></div>
