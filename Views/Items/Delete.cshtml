@model aluguel.Models.Item
@{ ViewData["Title"] = "Excluir item"; }
<div class="form-shell">
    <div class="page-heading"><div><div class="eyebrow">Meus itens / Excluir</div><h1>Excluir item</h1><p>Confirme antes de continuar.</p></div></div>
    <div class="form-card">
        <h2>Tem certeza que deseja excluir "@Model.nmitem"?</h2>
        <p class="muted">Esta ação não pode ser desfeita. Os anúncios associados ao item também podem ser afetados.</p>
        <form asp-action="Delete" method="post">
            <input asp-for="id" type="hidden" />
            <div class="form-actions"><button class="btn btn-danger" type="submit">Sim, excluir item</button><a class="btn btn-outline" asp-action="Index">Cancelar</a></div>
        </form>
    </div>
</div>
