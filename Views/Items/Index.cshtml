@model IEnumerable<aluguel.Models.Item>
@{
    ViewData["Title"] = "Meus itens";
}
<div class="page-heading">
    <div><div class="eyebrow">Minha área</div><h1>Meus itens</h1><p>Gerencie os objetos que cadastrou para alugar.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Cadastrar item</a>
</div>
@if (!Model.Any())
{
    <div class="empty-state">
        <span class="empty-icon" aria-hidden="true">▧</span>
        <h2>Seu espaço está pronto</h2>
        <p>Cadastre o primeiro item para começar a anunciar na RentAll.</p>
        <a class="btn btn-primary" asp-action="Create">Cadastrar meu primeiro item</a>
    </div>
}
else
{
    <div class="dashboard-grid">
        @foreach (var item in Model)
        {
            <article class="manage-card">
                @if (!string.IsNullOrWhiteSpace(item.imagem1))
                { <img class="manage-img" src="@Url.Content("~/imagens/" + item.imagem1)" alt="@item.nmitem" loading="lazy" /> }
                else { <div class="manage-img image-placeholder" aria-hidden="true">◇</div> }
                <div class="manage-info">
                    <span class="badge-pill @(item.snativo == "N" ? "off" : "")">@(item.snativo == "N" ? "Oculto" : "Ativo")</span>
                    <h2>@item.nmitem</h2>
                    <p>@item.dsitem</p>
                    <div class="item-actions">
                        <a asp-action="Details" asp-route-id="@item.id" class="details">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@item.id" class="edit">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.id" class="delete">Excluir</a>
                    </div>
                </div>
            </article>
        }
    </div>
}
