@model IEnumerable<aluguel.Models.Item>
@{
    ViewData["Title"] = "Meus Itens";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="ra-list-heading">Meus Itens<span>Gerencie seus produtos</span></h1>
<div class="create-container">
    <a asp-action="Create" class="create">Criar novo</a>
</div>
@if (!Model.Any())
{
    <div class="ra-empty-state">
        <h2>Nenhum item cadastrado</h2>
        <p>Cadastre o seu primeiro produto para começar.</p>
        <a asp-action="Create" class="create">Cadastrar item</a>
    </div>
}
else
{
    <table aria-label="Meus itens cadastrados">
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="item-content">
                        <img src="~/imagens/@item.imagem1" class="item-image" alt="@item.nmitem" loading="lazy" decoding="async" />
                        <div class="item-details">
                            <div class="item-name">@item.nmitem</div>
                            <div class="item-actions">
                                <a href="@Url.Action("Edit", "Items", new { id = item.id })" class="edit">Editar</a>
                                <a href="@Url.Action("Details", "Items", new { id = item.id })" class="details">Detalhes</a>
                                <a href="@Url.Action("Delete", "Items", new { id = item.id })" class="delete">Excluir</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
