@model aluguel.ViewModel.ItemViewModel
@{
    ViewData["Title"] = "Criar item";
}
<link rel="stylesheet" href="~/css/caditem.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/item-photos.css" asp-append-version="true" />
<div class="card-it">
    <h1>Criar item</h1>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="nmitem">Nome</label>
            <input asp-for="nmitem" class="form-control" required maxlength="150" />
        </div>
        <div class="form-group">
            <label asp-for="dsitem">Descrição</label>
            <textarea asp-for="dsitem" class="form-control" required></textarea>
        </div>
        <div class="form-group">
            <label asp-for="snativo">Visível desde já?</label>
            <select asp-for="snativo" class="form-control"><option value="S">Sim</option><option value="N">Não</option></select>
        </div>
        <section class="photo-picker" data-photo-picker>
  <div class="photo-picker-controls">
    <button type="button" data-photo-add>Adicionar fotografias</button>
    <span data-photo-count>0 / 5 fotografias</span>
  </div>
  <input type="file" name="photos" data-photo-input accept="image/jpeg,image/png,image/webp" multiple hidden />
  <div class="photo-navigation">
    <button type="button" data-photo-prev aria-label="Fotografia anterior">‹</button>
    <div class="photo-stage" data-photo-stage aria-live="polite"></div>
    <button type="button" data-photo-next aria-label="Fotografia seguinte">›</button>
  </div>
  <p class="photo-error" data-photo-error role="alert"></p>
</section>
        <button class="btn btn-success" type="submit">Guardar item</button>
        <a asp-action="Index" class="btn btn-secondary">Voltar à lista</a>
    </form>
</div>
@section Scripts {
    <script src="~/js/item-photos.js" asp-append-version="true"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}