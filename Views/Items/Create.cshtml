@model aluguel.ViewModel.ItemViewModel
@{
    ViewData["Title"] = "Cadastrar item";
}
<div class="form-shell">
    <div class="page-heading">
        <div><div class="eyebrow">Meus itens / Novo</div><h1>Cadastrar item</h1><p>Conte um pouco sobre o objeto e adicione fotografias.</p></div>
        <a asp-action="Index" class="btn btn-outline">← Voltar</a>
    </div>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <h2>Informações do item</h2>
        <div class="form-grid">
            <div class="field full"><label asp-for="nmitem">Nome do item *</label><input asp-for="nmitem" class="form-control" placeholder="Ex.: Câmera Sony, furadeira…" required maxlength="120" /><span asp-validation-for="nmitem" class="text-danger"></span></div>
            <div class="field full"><label asp-for="dsitem">Descrição *</label><textarea asp-for="dsitem" class="form-control" rows="4" placeholder="Estado, acessórios incluídos e informações úteis" required></textarea><span asp-validation-for="dsitem" class="text-danger"></span></div>
            <div class="field full"><label asp-for="snativo">Visibilidade</label><select asp-for="snativo" class="form-select"><option value="S">Ativo — posso anunciá-lo</option><option value="N">Oculto — guardar para depois</option></select></div>
        </div>
        <h2>Fotografias</h2>
        <p class="muted">A primeira fotografia é obrigatória. Até cinco imagens JPG, PNG ou WebP, com no máximo 5 MB cada.</p>
        <div class="form-grid">
            <div class="field full photo-input"><label asp-for="imagem1">Fotografia principal *</label><input asp-for="imagem1" type="file" accept="image/jpeg,image/png,image/webp" required class="form-control" /><span asp-validation-for="imagem1" class="text-danger"></span></div>
            <div class="field"><label asp-for="imagem2">Fotografia 2</label><input asp-for="imagem2" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /></div>
            <div class="field"><label asp-for="imagem3">Fotografia 3</label><input asp-for="imagem3" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /></div>
            <div class="field"><label asp-for="imagem4">Fotografia 4</label><input asp-for="imagem4" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /></div>
            <div class="field"><label asp-for="imagem5">Fotografia 5</label><input asp-for="imagem5" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Guardar item</button><a asp-action="Index" class="btn btn-outline">Cancelar</a></div>
    </form>
</div>
