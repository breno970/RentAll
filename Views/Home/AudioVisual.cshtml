@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@using aluguel.ViewModel
@{
    ViewData["Title"] = "ÁudioVisual";
    var filters = ViewData["Filters"] as MarketplaceFilters ?? new MarketplaceFilters();
}
<div class="ra-marketplace-heading">
    <div>
        <a asp-controller="Home" asp-action="Index" asp-route-Pais="@filters.Pais" class="ra-back-link">← Todas as categorias</a>
        <h1>ÁudioVisual</h1>
        <p>Explore itens desta categoria na região que escolher.</p>
    </div>
</div>
<partial name="_MarketplaceFilters" model="filters" />
<div class="ra-results-heading">
    <h2>Anúncios em ÁudioVisual</h2>
    <p>@Model.TotalItemCount anúncio(s) encontrado(s)</p>
</div>
<partial name="_MarketplaceCards" model="Model" />
@if (Model.PageCount > 1)
{
    <div class="mil"><div class="pagination-container">
        <span>Página @Model.PageNumber de @Model.PageCount</span>
        @Html.PagedListPager(Model, page => Url.Action("AudioVisual", new {
            page, filters.Pais, filters.SearchString, filters.Estado, filters.RegionFilter,
            filters.Bairro, filters.MinPrice, filters.MaxPrice, filters.Sort
        }))
    </div></div>
}
