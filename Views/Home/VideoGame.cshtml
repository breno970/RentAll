@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Videogames";
}
<div class="page-heading">
    <div>
        <div class="eyebrow"><a asp-area="" asp-controller="Home" asp-action="Index">Explorar</a> / Categorias</div>
        <h1>🎮 Videogames</h1>
        <p>Explore os itens disponíveis nesta categoria.</p>
    </div>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline">← Todas as categorias</a>
</div>
<form asp-area="" asp-controller="Home" asp-action="VideoGame" method="get" class="search-panel" role="search">
    <div class="field">
        <label for="searchString">Pesquisar nesta categoria</label>
        <input id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="O que procura?" />
    </div>
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>
<div class="section-title">
    <div><h2>Itens para alugar</h2><p>@Model.TotalItemCount anúncio(s) encontrado(s)</p></div>
</div>
<partial name="_ListingGrid" model="Model" />
@if (Model.PageCount > 1)
{
    <div class="pagination-container" aria-label="Paginação">
        @Html.PagedListPager(Model, page => Url.Action("VideoGame", new { page, searchString = ViewData["CurrentFilter"] }))
    </div>
}
