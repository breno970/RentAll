@model aluguel.Models.Anuncio
@{
    ViewData["Title"] = Model.item?.nmitem ?? "Anúncio";
}
<div class="page-width">
    <div class="empty-state">
        <div class="empty-symbol"><i class="fas fa-info-circle"></i></div>
        <h2>Este anúncio tem uma página de detalhes.</h2>
        <p>Encontra mais fotografias, informações e o contacto do anunciante.</p>
        <a class="btn btn-primary" asp-controller="Anuncios" asp-action="Details" asp-route-id="@Model.id">Ver anúncio</a>
    </div>
</div>
