@model IEnumerable<aluguel.ViewModel.DemoCatalogItem>
@{ ViewData["Title"] = "Exemplos de aluguer"; }
<div class="page-width market-results market-demo-catalog">
    <div class="page-intro market-category-intro">
        <div>
            <h1>Experimenta um aluguer</h1>
            <p>Escolhe um artigo de exemplo para veres como funcionam o pagamento, a recolha e a devolução. Sem conta nem reserva.</p>
        </div>
        <a class="btn btn-outline" asp-action="Index">Ver anúncios</a>
    </div>
    <partial name="_DemoCatalogCards" model="Model" />
</div>
