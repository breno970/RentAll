@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@using aluguel.ViewModel
@{
    ViewData["Title"] = "Aluga o que precisas, perto de ti";
    var filters = ViewData["Filters"] as MarketplaceFilters ?? new MarketplaceFilters();
    var browsing = !filters.CategoriaId.HasValue && !filters.MinPrice.HasValue && !filters.MaxPrice.HasValue &&
        string.IsNullOrWhiteSpace(filters.SearchString) && string.IsNullOrWhiteSpace(filters.Estado) &&
        string.IsNullOrWhiteSpace(filters.RegionFilter) && string.IsNullOrWhiteSpace(filters.Bairro) &&
        filters.Sort == "recentes" && (filters.Page ?? 1) == 1;
}
<section class="market-search" aria-labelledby="market-title">
    <div class="page-width">
        @if (browsing)
        {
            <div class="market-banner">
                <div class="market-banner-copy">
                    <h1 id="market-title">Aluga o que precisas,<br />perto de ti.</h1>
                    <p>Encontra ferramentas, equipamento e outros artigos para alugar em Portugal.</p>
                </div>
                <img class="market-banner-photo" src="~/catalogo/aluguer.jpg" alt="" width="750" height="500" fetchpriority="high" />
            </div>
        }
        else
        {
            <h1 id="market-title" class="market-search-title">Pesquisar artigos</h1>
        }
        <partial name="_MarketplaceFilters" model="filters" />
    </div>
</section>

@if (browsing)
{
    <section class="market-categories" aria-labelledby="category-heading">
        <div class="page-width">
            <h2 id="category-heading">Categorias</h2>
            <nav class="market-category-grid" aria-label="Categorias de aluguer">
                @foreach (var category in MarketplaceCategory.All)
                {
                    <a asp-controller="Home" asp-action="@category.Action" asp-route-Pais="@filters.Pais">
                        <img src="~/catalogo/@category.Photo" alt="" width="96" height="96" />
                        <span>@category.Name</span>
                    </a>
                }
            </nav>
        </div>
    </section>
}

<section id="procurar" class="market-results page-width" aria-labelledby="results-heading">
    @if (browsing && Model.TotalItemCount == 0)
    {
        <div class="results-heading">
            <div>
                <h2 id="results-heading">Exemplos de aluguer</h2>
                <p>Artigos e preços ilustrativos. Escolhe uma categoria para procurar anúncios publicados.</p>
            </div>
        </div>
        <div class="listing-grid">
            @foreach (var category in MarketplaceCategory.All)
            {
                <article class="listing-card">
                    <a class="listing-image" asp-action="@category.Action" aria-label="Explorar @category.Name">
                        <img src="~/catalogo/@category.Photo" alt="" width="512" height="512" loading="lazy" />
                    </a>
                    <div class="listing-body">
                        <span class="listing-kicker">@category.Name</span>
                        <h3><a asp-action="@category.Action">@category.Example</a></h3>
                        <div class="listing-price">@aluguel.Services.RentalLocalization.FormatPrice(category.DailyPrice, "PT") <small>/ dia</small></div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="results-heading">
            <div>
                <h2 id="results-heading">@(browsing ? "Anúncios recentes" : "Resultados da pesquisa")</h2>
                <p>@Model.TotalItemCount @(Model.TotalItemCount == 1 ? "anúncio" : "anúncios")</p>
            </div>
        </div>
        <partial name="_MarketplaceCards" model="Model" />
        @if (Model.PageCount > 1)
        {
            <div class="pagination-wrap">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, filters.Pais, filters.SearchString, filters.Estado, filters.RegionFilter, filters.Bairro, filters.CategoriaId, filters.MinPrice, filters.MaxPrice, filters.Sort }))
            </div>
        }
    }
</section>
