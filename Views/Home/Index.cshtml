@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@using aluguel.ViewModel
@{
    ViewData["Title"] = "Itens para alugar";
    var filters = ViewData["Filters"] as MarketplaceFilters ?? new MarketplaceFilters();
}
<div class="ra-marketplace-heading">
    <div>
        <h1>Encontre o que precisa. Aproveite o que já existe.</h1>
        <p>Alugue objetos em desuso perto de você, com os melhores preços da região.</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Items" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> Anunciar item</a>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> Quero anunciar</a>
    }
</div>

<partial name="_MarketplaceFilters" model="filters" />

<div class="mil ra-categories" aria-label="Categorias de itens">
    <div class="form">
        <a class="btn btn-primary" asp-action="VideoGame">VideoGame</a>
        <a class="btn btn-primary" asp-action="AudioVisual">ÁudioVisual</a>
        <a class="btn btn-primary" asp-action="MusicaHobbie">Música&amp;Hobbies</a>
        <a class="btn btn-primary" asp-action="EsporteGinastica">Esporte&amp;Ginástica</a>
        <a class="btn btn-primary" asp-action="Ferramentas">Ferramentas</a>
        <a class="btn btn-primary" asp-action="Eletrodomesticos">EletroDomésticos</a>
    </div>
</div>

<div class="ra-results-heading">
    <h2>Itens disponíveis</h2>
    <p>@Model.TotalItemCount anúncio(s) encontrado(s)</p>
</div>
<partial name="_MarketplaceCards" model="Model" />
@if (Model.PageCount > 1)
{
    <div class="mil">
        <div class="pagination-container">
            <span>Página @Model.PageNumber de @Model.PageCount</span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new {
                page, filters.SearchString, filters.Estado, filters.RegionFilter,
                filters.Bairro, filters.CategoriaId, filters.MinPrice, filters.MaxPrice, filters.Sort
            }))
        </div>
    </div>
}
