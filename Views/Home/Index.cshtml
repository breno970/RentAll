@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Início";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<form asp-controller="Home" asp-action="Index" method="get" class="form-se ra-search" role="search">
    <label class="visually-hidden" for="SearchString">Pesquisar itens</label>
    <input id="SearchString" class="form-control" type="search" name="SearchString" placeholder="Pesquisar por..." value="@ViewData["CurrentFilter"]" aria-label="Pesquisar itens" />
    <label class="visually-hidden" for="RegionFilter">Cidade</label>
    <input id="RegionFilter" class="form-control" type="text" name="RegionFilter" placeholder="Todas as regiões" value="@ViewData["RegionFilter"]" aria-label="Filtrar por cidade" />
    <button type="submit" class="btn btn-outline-dark">Buscar</button>
</form>

<div class="mil">
    <div class="form" aria-label="Categorias de itens">
        <a class="btn btn-primary" asp-action="VideoGame">VideoGame</a>
        <a class="btn btn-primary" asp-action="AudioVisual">ÁudioVisual</a>
        <a class="btn btn-primary" asp-action="MusicaHobbie">Música&amp;Hobbies</a>
        <a class="btn btn-primary" asp-action="EsporteGinastica">Esporte&amp;Ginástica</a>
        <a class="btn btn-primary" asp-action="Ferramentas">Ferramentas</a>
        <a class="btn btn-primary" asp-action="EletroDomesticos">EletroDomésticos</a>
    </div>
</div>

@if (Model.Any())
{
    <div class="l-cards">
        @foreach (var item in Model)
        {
            <div class="c-card">
                <div class="c-card__image">
                    <img class="img" src="~/imagens/@item.item.imagem1"
                         alt="@item.item.nmitem" loading="lazy" decoding="async" />
                </div>
                <div class="c-card__content">
                    <h1>@item.item.nmitem</h1>
                    <p>@item.modelo</p>
                    <h3>Dias de Aluguel: @item.diasAluguel</h3>
                    <span>R$: @item.vlitem</span>
                    <a asp-controller="Anuncios" asp-action="Details" asp-route-id="@item.id">Saiba+</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="mil" style="text-align:center;padding:30px 18px">
        <h2>Nenhum anúncio encontrado</h2>
        <p>Tente outra pesquisa ou explore uma das categorias.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Ver todos os anúncios</a>
    </div>
}

@if (Model.PageCount > 1)
{
    <div class="mil">
        <div class="pagination-container">
            <span>Página @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount</span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"], RegionFilter = ViewData["RegionFilter"] }))
        </div>
    </div>
}

