@model X.PagedList.IPagedList<aluguel.Models.Anuncio>
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Explore itens";
    var categories = new[] {
        new { Label = "Videogames", Route = "VideoGame", Icon = "🎮" },
        new { Label = "Áudio e vídeo", Route = "AudioVisual", Icon = "📷" },
        new { Label = "Música e hobbies", Route = "MusicaHobbie", Icon = "🎸" },
        new { Label = "Esporte e lazer", Route = "EsporteGinastica", Icon = "🚲" },
        new { Label = "Ferramentas", Route = "Ferramentas", Icon = "🛠" },
        new { Label = "Eletrodomésticos", Route = "Eletrodomesticos", Icon = "🏠" }
    };
}
<section class="hero" aria-labelledby="hero-title">
    <div>
        <div class="eyebrow">Bem-vindo ao RentAll</div>
        <h1 id="hero-title">Tudo o que precisa, <em>sem precisar comprar.</em></h1>
        <p>Descubra itens para alugar na sua região. Mais liberdade para experimentar, criar e fazer acontecer.</p>
        <a href="#explorar" class="btn">Explorar anúncios ↓</a>
    </div>
    <aside class="hero-side">
        <span style="font-size:2rem" aria-hidden="true">✦</span>
        <b>Tem algo parado em casa?</b>
        <p>Transforme itens que não usa todos os dias em oportunidades de aluguel.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-area="" asp-controller="Items" asp-action="Create" class="btn">Cadastrar meu item</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn">Quero anunciar</a>
        }
    </aside>
</section>
<section id="explorar" style="scroll-margin-top:110px" aria-labelledby="search-title">
    <form asp-area="" asp-controller="Home" asp-action="Index" method="get" class="search-panel" role="search">
        <div class="field">
            <label for="searchString">O que você procura?</label>
            <input id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Ex.: câmera, furadeira, bicicleta…" autocomplete="off" />
        </div>
        <div class="field">
            <label for="RegionFilter">Cidade</label>
            <input id="RegionFilter" name="RegionFilter" value="@ViewData["RegionFilter"]" placeholder="Todas as cidades" />
        </div>
        <button class="btn btn-primary" type="submit">Buscar itens</button>
    </form>
    <div class="eyebrow">Encontre por categoria</div>
    <nav class="categories" aria-label="Categorias">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="category-chip active">✦ Tudo</a>
        @foreach (var cat in categories)
        {
            <a class="category-chip" asp-area="" asp-controller="Home" asp-action="@cat.Route"><span aria-hidden="true">@cat.Icon</span> @cat.Label</a>
        }
    </nav>
    <div class="section-title">
        <div>
            <div class="eyebrow">Seleção RentAll</div>
            <h2 id="search-title">Explore os anúncios</h2>
            <p>Encontre o que precisa e fale diretamente com quem anuncia.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Anuncios" asp-action="Index" class="btn btn-outline">Meus anúncios</a>
        }
    </div>
    <partial name="_ListingGrid" model="Model" />
    @if (Model.PageCount > 1)
    {
        <div class="pagination-container" aria-label="Paginação">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewData["CurrentFilter"], RegionFilter = ViewData["RegionFilter"] }))
        </div>
    }
</section>
